[Unit]
Description=Apply Node Starter Stack node state requests
After=docker.service
Requires=docker.service
ConditionPathExists=/var/lib/bitcoin-starter-stack/.env

[Service]
Type=oneshot
ExecStart=/usr/lib/bitcoin-starter-stack/node-control
Environment=BITCOIN_STACK_PACKAGE_MANAGED=1
Environment=BITCOIN_STACK_ROOT=/usr/lib/bitcoin-starter-stack
Environment=BITCOIN_STACK_STATE_DIR=/var/lib/bitcoin-starter-stack
Environment=BITCOIN_STACK_CONFIG_DIR=/etc/bitcoin-starter-stack
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/bitcoin-starter-stack /var/lib/bitcoin-starter-stack
RestrictAddressFamilies=AF_UNIX AF_NETLINK
