[Unit]
Description=Apply steady resource limits to synced Node Starter Stack nodes
After=docker.service
Requires=docker.service
ConditionPathExists=/var/lib/bitcoin-starter-stack/.env

[Service]
Type=oneshot
ExecStart=/usr/lib/bitcoin-starter-stack/node-resource-profile
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bitcoin-starter-stack
RestrictAddressFamilies=AF_UNIX
