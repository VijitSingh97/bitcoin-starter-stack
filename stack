#!/usr/bin/env bash
# Single entry point for operating the stack. Run ./stack help for usage.
set -euo pipefail
stack_root=${BITCOIN_STACK_ROOT:-$(cd "$(dirname "$0")" && pwd)}
state_dir=${BITCOIN_STACK_STATE_DIR:-$stack_root}
config_dir=${BITCOIN_STACK_CONFIG_DIR:-$state_dir}
config_file=$config_dir/config.json
env_file=$state_dir/.env
stack_command=${BITCOIN_STACK_COMMAND:-./stack}
package_managed=${BITCOIN_STACK_PACKAGE_MANAGED:-0}
project_name=${BITCOIN_STACK_PROJECT_NAME:-bitcoin-starter-stack-apt}
[ "$package_managed" != brew ] || project_name=${BITCOIN_STACK_PROJECT_NAME:-bitcoin-starter-stack-brew}
export BITCOIN_STACK_PROJECT_NAME="$project_name"
config_lock_owned=0

lock_config() {
  [ "${BITCOIN_STACK_CONFIG_LOCK_HELD:-0}" != 1 ] || return 0
  mkdir -p "$state_dir"
  exec 8>"$state_dir/.config.lock"
  flock 8
  export BITCOIN_STACK_CONFIG_LOCK_HELD=1
  config_lock_owned=1
}

unlock_config() {
  [ "$config_lock_owned" = 1 ] || return 0
  flock -u 8
  unset BITCOIN_STACK_CONFIG_LOCK_HELD
  config_lock_owned=0
}

replace_config() {
  local source=$1 target
  mkdir -p "$state_dir" "$config_dir"
  lock_config
  target=$(mktemp "$config_dir/.config.write.XXXXXX")
  chmod 600 "$target"
  cat "$source" >"$target"
  mv "$target" "$config_file"
  unlock_config
}
cd "$state_dir"

compose() {
  if [ "$state_dir" = "$stack_root" ]; then
    docker compose "$@"
  else
    local compose_file compose_files=()
    compose_file=$(env_get COMPOSE_FILE)
    compose_file=${compose_file:-docker-compose.yml}
    IFS=: read -ra compose_files <<<"$compose_file"
    local compose_args=()
    for compose_file in "${compose_files[@]}"; do
      case "$compose_file" in
        docker-compose.yml | docker-compose.rpc.yml | docker-compose.monero-rpc.yml | docker-compose.monero-zmq.yml | docker-compose.tari-grpc.yml | docker-compose.litecoin-rpc.yml | docker-compose.dogecoin-rpc.yml | docker-compose.bitcoincash-rpc.yml | docker-compose.zcash-rpc.yml)
          compose_args+=( -f "$stack_root/$compose_file" )
          ;;
        *)
          echo "Unsupported package Compose file: $compose_file" >&2
          return 1
          ;;
      esac
    done
    docker compose --project-name "$project_name" \
      --project-directory "$state_dir" --env-file "$env_file" \
      "${compose_args[@]}" "$@"
  fi
}

guard_package_containers() {
  [ "$package_managed" != 0 ] || return 0
  local service config working_dir
  for service in tor bitcoin monero monero-wallet tari litecoin dogecoin bitcoincash zcash dashboard; do
    config=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files" }}' "$service" 2>/dev/null) || continue
    case ",$config," in
      *",$stack_root/docker-compose.yml,"*) ;;
      *)
        echo "Existing $service container belongs to another installation; package mode will not replace it." >&2
        echo "Keep the source deployment or stop it and plan a manual migration; see docs/operations.md." >&2
        return 1
        ;;
    esac
    working_dir=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir" }}' "$service" 2>/dev/null) || return 1
    if [ "$working_dir" != "$state_dir" ]; then
      echo "Existing $service container belongs to another installation; this installation will not replace it." >&2
      return 1
    fi
  done
}

usage() {
  cat <<EOF
Usage: $stack_command <command> [args]

  up | down | restart [svc]  Start / stop / restart the stack (or one service)
  pull                       Download container images using host Docker settings
  init                       Interactive setup wizard (optional; up uses defaults)
  logs [svc]                 Follow logs (all services, or one)
  events                     Incident history (down/recovered, failed pings) — survives restarts
  apply                      Re-render .env from config.json and apply changes
  upgrade                    Fetch the latest release and apply it (backs up first)
  upgrade-agent              Watch for source-install dashboard requests (auto-managed)
  host-service               Supervise configured nodes and host controls (Homebrew service)
  status                     Container + health summary; warns on anything down
  doctor                     Read-only health report (deps, disk, sync, tor)
  backup                     Save config, credentials, and onion keys to backups/
  restore [-y] <archive>     Restore a backup archive (prompts before overwrite)
  help                       This text
EOF
}

env_get() { sed -n "s/^$1=//p" "$env_file" 2>/dev/null || true; }

init() {
  umask 077
  for tool in jq openssl; do
    command -v "$tool" >/dev/null || {
      echo "$tool is required; install it with your host package manager."
      exit 1
    }
  done

  old_config='{}'
  [ -f "$config_file" ] && old_config=$(cat "$config_file")
  if [ -f "$config_file" ]; then
    printf "config.json already exists — overwrite it? [y/N] "
    read -r reply
    case "$reply" in y | Y) ;; *)
      echo "Kept existing config.json. (Edit it and $stack_command apply, or $stack_command up.)"
      return 0
      ;;
    esac
  fi

  echo "Setup — press Enter to accept the [default]. Nothing here is required."
  echo "The default keeps 10 GB of recent blocks and needs about 30–60 GB total disk."
  echo "Bitcoin Core still downloads and validates the whole chain; over Tor, first sync can take days."
  echo
  yes() { case "$1" in y | Y | yes | YES) return 0 ;; *) return 1 ;; esac; }
  if [ -n "${BITCOIN_STACK_DATA_DIR:-}" ]; then
    default_data_dir=$BITCOIN_STACK_DATA_DIR/bitcoin
  else
    default_data_dir=./data/bitcoin
  fi
  current_data_dir=$(jq -r '.bitcoin.data_dir // empty' <<<"$old_config")
  [ -n "$current_data_dir" ] || current_data_dir=$(env_get BITCOIN_DATA_DIR)
  [ -n "$current_data_dir" ] || current_data_dir=$default_data_dir
  current_bind_ip=$(jq -r '.dashboard.bind_ip // empty' <<<"$old_config")
  [ -n "$current_bind_ip" ] || current_bind_ip=$(env_get DASHBOARD_BIND_IP)
  [ -n "$current_bind_ip" ] || current_bind_ip=127.0.0.1
  current_prune=$(jq -r '.bitcoin.prune_mb // empty' <<<"$old_config")
  [ -n "$current_prune" ] || current_prune=$(env_get BITCOIN_PRUNE)
  [ -n "$current_prune" ] || if [ -f "$env_file" ]; then current_prune=0; else current_prune=10000; fi
  current_dashboard_onion=$(jq -r 'if ((.dashboard // {}) | has("onion")) then if .dashboard.onion == true then 1 else 0 end else empty end' <<<"$old_config")
  [ -n "$current_dashboard_onion" ] || current_dashboard_onion=$(env_get DASHBOARD_ONION)
  [ -n "$current_dashboard_onion" ] || current_dashboard_onion=0
  current_inbound_onion=$(jq -r 'if ((.bitcoin // {}) | has("inbound_onion")) then if .bitcoin.inbound_onion == true then 1 else 0 end else empty end' <<<"$old_config")
  [ -n "$current_inbound_onion" ] || current_inbound_onion=$(env_get BITCOIN_INBOUND_ONION)
  [ -n "$current_inbound_onion" ] || current_inbound_onion=0
  read -rsp "Dashboard password (letters/numbers) [Enter = strong random]: " w_password; echo
  if [ -z "$w_password" ]; then
    w_password=$(openssl rand -hex 24)
  fi
  case "$w_password" in *[!a-zA-Z0-9]*) echo "Password must contain only letters and numbers."; return 1 ;; esac
  w_bitcoin_password=$(openssl rand -hex 24)
  w_monero_password=$(openssl rand -hex 24)
  w_litecoin_password=$(openssl rand -hex 24)
  w_dogecoin_password=$(openssl rand -hex 24)
  w_bitcoincash_password=$(openssl rand -hex 24)
  w_zcash_password=$(openssl rand -hex 24)
  read -r -p "Nodes to run (comma-separated: bitcoin, monero, tari, litecoin, dogecoin, bitcoincash, zcash) [bitcoin]: " w_nodes || true
  [ -n "$w_nodes" ] || w_nodes=bitcoin
  w_bitcoin_enabled=0; w_monero_enabled=0; w_tari_enabled=0; w_litecoin_enabled=0; w_dogecoin_enabled=0; w_bitcoincash_enabled=0; w_zcash_enabled=0
  old_ifs=$IFS; IFS=,
  for node in $w_nodes; do
    node=$(printf '%s' "$node" | tr -d ' ')
    case "$node" in
      bitcoin) w_bitcoin_enabled=1 ;; monero) w_monero_enabled=1 ;; tari) w_tari_enabled=1 ;;
      both) w_bitcoin_enabled=1; w_monero_enabled=1 ;;
      litecoin) w_litecoin_enabled=1 ;; dogecoin) w_dogecoin_enabled=1 ;; bitcoincash) w_bitcoincash_enabled=1 ;;
      zcash) w_zcash_enabled=1 ;;
      *) IFS=$old_ifs; echo "Unknown node: $node"; return 1 ;;
    esac
  done
  IFS=$old_ifs
  read -r -p "Dashboard bind address (loopback or private LAN) [$current_bind_ip]: " w_bind_ip
  [ -n "$w_bind_ip" ] || w_bind_ip=$current_bind_ip
  if [ "$package_managed" != "0" ]; then
    w_control=n
  else
    read -r -p "One-click upgrades from the dashboard (Upgrade button)? [y/N] " w_control
  fi
  w_data_dir=$current_data_dir
  w_rpc_expose=n
  w_rpc_bind_ip=
  w_rpc_port=
  w_prune_gb=
  if [ "$w_bitcoin_enabled" = "1" ]; then
    read -r -p "Bitcoin data directory [$current_data_dir]: " w_data_dir
    [ -n "$w_data_dir" ] || w_data_dir=$current_data_dir
    read -r -p "Expose Bitcoin RPC to trusted LAN wallet apps? [y/N] " w_rpc_expose
    if yes "$w_rpc_expose"; then
      read -r -p "Private LAN address assigned to this host [required]: " w_rpc_bind_ip
      read -r -p "Host RPC port [8332]: " w_rpc_port
    fi
    if [ "$current_prune" = "0" ]; then
      prune_prompt="Recent-block retention in GB [keep existing archival node]: "
    elif [ "$current_prune" -lt 1000 ]; then
      prune_prompt="Recent-block retention in GB [keep existing $current_prune MB]: "
    else
      prune_prompt="Recent-block retention in GB [$((current_prune / 1000))]: "
    fi
    read -r -p "$prune_prompt" w_prune_gb
  fi
  w_monero_data_dir=
  w_monero_rpc_expose=n
  w_monero_zmq_expose=n
  w_monero_rpc_bind_ip=
  w_monero_rpc_port=
  w_monero_zmq_bind_ip=
  w_monero_zmq_port=
  if [ "$w_monero_enabled" = "1" ]; then
    if [ -n "${BITCOIN_STACK_DATA_DIR:-}" ]; then
      default_monero_data_dir=$BITCOIN_STACK_DATA_DIR/monero
    else
      default_monero_data_dir=./data/monero
    fi
    read -r -p "Monero data directory [$default_monero_data_dir]: " w_monero_data_dir
    [ -n "$w_monero_data_dir" ] || w_monero_data_dir=$default_monero_data_dir
    read -r -p "Expose restricted Monero RPC to trusted LAN apps? [y/N] " w_monero_rpc_expose
    if yes "$w_monero_rpc_expose"; then
      read -r -p "Private LAN address assigned to this host [required]: " w_monero_rpc_bind_ip
      read -r -p "Host Monero RPC port [18081]: " w_monero_rpc_port
    fi
    read -r -p "Expose Monero ZMQ to a trusted LAN P2Pool host? [y/N] " w_monero_zmq_expose
    if yes "$w_monero_zmq_expose"; then
      read -r -p "Private LAN address assigned to this host [required]: " w_monero_zmq_bind_ip
      read -r -p "Host Monero ZMQ port [18083]: " w_monero_zmq_port
    fi
  fi

  for node_spec in "tari:Tari:grpc:18142" "litecoin:Litecoin:rpc:9332" "dogecoin:Dogecoin:rpc:22555" "bitcoincash:Bitcoin Cash:rpc:8332" "zcash:Zcash:rpc:8232"; do
    IFS=: read -r node label kind default_port <<<"$node_spec"
    enabled_var=w_${node}_enabled
    enabled=${!enabled_var}
    [ "$enabled" = 1 ] || continue
    if [ -n "${BITCOIN_STACK_DATA_DIR:-}" ]; then default_node_data_dir=$BITCOIN_STACK_DATA_DIR/$node; else default_node_data_dir=./data/$node; fi
    read -r -p "$label data directory [$default_node_data_dir]: " node_data_dir
    [ -n "$node_data_dir" ] || node_data_dir=$default_node_data_dir
    printf -v "w_${node}_data_dir" '%s' "$node_data_dir"
    read -r -p "Expose $label $(printf '%s' "$kind" | tr '[:lower:]' '[:upper:]') to trusted LAN apps? [y/N] " node_expose
    printf -v "w_${node}_${kind}_expose" '%s' "$node_expose"
    if yes "$node_expose"; then
      read -r -p "Private LAN address assigned to this host [required]: " node_bind_ip
      read -r -p "Host $label $(printf '%s' "$kind" | tr '[:lower:]' '[:upper:]') port [$default_port]: " node_port
      printf -v "w_${node}_${kind}_bind_ip" '%s' "$node_bind_ip"
      printf -v "w_${node}_${kind}_port" '%s' "${node_port:-$default_port}"
    fi
  done

  cfg=$(jq -n '{}')
  cfg=$(jq --arg dashboard "$w_password" --arg bitcoin "$w_bitcoin_password" --arg monero "$w_monero_password" \
    --arg litecoin "$w_litecoin_password" --arg dogecoin "$w_dogecoin_password" --arg bitcoincash "$w_bitcoincash_password" --arg zcash "$w_zcash_password" '
    .dashboard.password=$dashboard | .bitcoin.node_password=$bitcoin | .monero.node_password=$monero |
    .litecoin.node_password=$litecoin | .dogecoin.node_password=$dogecoin | .bitcoincash.node_password=$bitcoincash |
    .zcash.node_password=$zcash' <<<"$cfg")
  [ "$w_bitcoin_enabled" = "0" ] && cfg=$(jq '.bitcoin.enabled=false' <<<"$cfg")
  [ "$w_monero_enabled" = "1" ] && cfg=$(jq '.monero.enabled=true' <<<"$cfg")
  [ "$w_tari_enabled" = "1" ] && cfg=$(jq '.tari.enabled=true' <<<"$cfg")
  [ "$w_litecoin_enabled" = "1" ] && cfg=$(jq '.litecoin.enabled=true' <<<"$cfg")
  [ "$w_dogecoin_enabled" = "1" ] && cfg=$(jq '.dogecoin.enabled=true' <<<"$cfg")
  [ "$w_bitcoincash_enabled" = "1" ] && cfg=$(jq '.bitcoincash.enabled=true' <<<"$cfg")
  [ "$w_zcash_enabled" = "1" ] && cfg=$(jq '.zcash.enabled=true' <<<"$cfg")
  [ "$w_bitcoin_enabled" = "1" ] && cfg=$(jq '.bitcoin.steady_cpus=1 | .bitcoin.steady_mem_limit_mb=2048' <<<"$cfg")
  [ "$w_monero_enabled" = "1" ] && cfg=$(jq '.monero.steady_cpus=1 | .monero.steady_mem_limit_mb=2048' <<<"$cfg")
  for node in tari litecoin dogecoin bitcoincash zcash; do
    enabled_var=w_${node}_enabled
    enabled=${!enabled_var}
    [ "$enabled" = 1 ] && cfg=$(jq --arg node "$node" '.[$node].steady_cpus=1 | .[$node].steady_mem_limit_mb=4096' <<<"$cfg")
  done
  if [ "$package_managed" != "0" ]; then
    [ "$w_bitcoin_enabled" = "1" ] && cfg=$(jq '.bitcoin.resource_profile="compact"' <<<"$cfg")
    [ "$w_monero_enabled" = "1" ] && cfg=$(jq '.monero.resource_profile="compact"' <<<"$cfg")
    for node in tari litecoin dogecoin bitcoincash zcash; do
      enabled_var=w_${node}_enabled
      enabled=${!enabled_var}
      [ "$enabled" = 1 ] && cfg=$(jq --arg node "$node" '.[$node].resource_profile="compact"' <<<"$cfg")
    done
  fi
  [ "$w_data_dir" != "$default_data_dir" ] && cfg=$(jq --arg v "$w_data_dir" '.bitcoin.data_dir=$v' <<<"$cfg")
  [ "$w_bind_ip" != "127.0.0.1" ] && cfg=$(jq --arg v "$w_bind_ip" '.dashboard.bind_ip=$v' <<<"$cfg")
  [ "$current_dashboard_onion" = "1" ] && cfg=$(jq '.dashboard.onion=true' <<<"$cfg")
  [ "$current_inbound_onion" = "1" ] && cfg=$(jq '.bitcoin.inbound_onion=true' <<<"$cfg")
  yes "$w_control" && cfg=$(jq '.dashboard.control=true' <<<"$cfg")
  if yes "$w_rpc_expose"; then
    cfg=$(jq --arg ip "$w_rpc_bind_ip" '.bitcoin.rpc_expose=true | .bitcoin.rpc_bind_ip=$ip' <<<"$cfg")
    [ -n "$w_rpc_port" ] && cfg=$(jq --argjson port "$w_rpc_port" '.bitcoin.rpc_port=$port' <<<"$cfg")
  fi
  if [ -n "$w_prune_gb" ]; then
    case "$w_prune_gb" in
      *[!0-9]*) echo "  (retention must be a whole number of GB — keeping the default)" ;;
      *) current_prune=$((w_prune_gb * 1000)) ;;
    esac
  fi
  cfg=$(jq --argjson v "$current_prune" '.bitcoin.prune_mb=$v' <<<"$cfg")
  if [ "$w_monero_enabled" = "1" ]; then
    [ "$w_monero_data_dir" != "$default_monero_data_dir" ] && cfg=$(jq --arg v "$w_monero_data_dir" '.monero.data_dir=$v' <<<"$cfg")
    if yes "$w_monero_rpc_expose"; then
      cfg=$(jq --arg ip "$w_monero_rpc_bind_ip" '.monero.rpc_expose=true | .monero.rpc_bind_ip=$ip' <<<"$cfg")
      [ -n "$w_monero_rpc_port" ] && cfg=$(jq --argjson port "$w_monero_rpc_port" '.monero.rpc_port=$port' <<<"$cfg")
    fi
    if yes "$w_monero_zmq_expose"; then
      cfg=$(jq --arg ip "$w_monero_zmq_bind_ip" '.monero.zmq_expose=true | .monero.zmq_bind_ip=$ip' <<<"$cfg")
      [ -n "$w_monero_zmq_port" ] && cfg=$(jq --argjson port "$w_monero_zmq_port" '.monero.zmq_port=$port' <<<"$cfg")
    fi
  fi
  for node_spec in "tari:grpc" "litecoin:rpc" "dogecoin:rpc" "bitcoincash:rpc" "zcash:rpc"; do
    IFS=: read -r node kind <<<"$node_spec"
    enabled_var=w_${node}_enabled
    enabled=${!enabled_var}
    [ "$enabled" = 1 ] || continue
    data_var=w_${node}_data_dir
    node_data_dir=${!data_var}
    cfg=$(jq --arg node "$node" --arg data "$node_data_dir" 'setpath([$node,"data_dir"];$data)' <<<"$cfg")
    expose_var=w_${node}_${kind}_expose
    node_expose=${!expose_var}
    if yes "$node_expose"; then
      bind_var=w_${node}_${kind}_bind_ip
      port_var=w_${node}_${kind}_port
      node_bind_ip=${!bind_var}
      node_port=${!port_var}
      cfg=$(jq --arg node "$node" --arg kind "$kind" --arg ip "$node_bind_ip" --argjson port "$node_port" '
        setpath([$node,($kind+"_expose")];true) |
        setpath([$node,($kind+"_bind_ip")];$ip) |
        setpath([$node,($kind+"_port")];$port)' <<<"$cfg")
    fi
  done

  config_source=$(mktemp)
  printf '%s\n' "$cfg" | jq . >"$config_source"
  replace_config "$config_source"
  rm -f "$config_source"
  if [ "$package_managed" = "1" ]; then ensure_port_control_timer; ensure_node_control_timer; fi
  echo
  echo "Wrote private config.json (mode 600)."
  echo
  printf "Download missing containers and start the stack now? [Y/n] "
  read -r reply
  case "$reply" in n | N) echo "Later: $stack_command pull && $stack_command up" ;; *)
    lock_config
    "$stack_root/configure.sh"
    guard_package_containers
    images_available || pull_images
    offline_up
    unlock_config
    ensure_resource_profile_timer
    ensure_agent
    ;;
  esac
  echo
  echo "Generated credentials (shown once):"
  echo "  Dashboard — username: admin  password: $w_password"
  [ "$w_bitcoin_enabled" = "0" ] || echo "  Bitcoin RPC — username: admin  password: $w_bitcoin_password"
  [ "$w_monero_enabled" = "0" ] || echo "  Monero RPC — username: admin  password: $w_monero_password"
  [ "$w_litecoin_enabled" = "0" ] || echo "  Litecoin RPC — username: admin  password: $w_litecoin_password"
  [ "$w_dogecoin_enabled" = "0" ] || echo "  Dogecoin RPC — username: admin  password: $w_dogecoin_password"
  [ "$w_bitcoincash_enabled" = "0" ] || echo "  Bitcoin Cash RPC — username: admin  password: $w_bitcoincash_password"
  [ "$w_zcash_enabled" = "0" ] || echo "  Zcash RPC proxy — username: admin  password: $w_zcash_password"
  [ "$w_tari_enabled" = "0" ] || echo "  Tari gRPC — no password; keep LAN exposure on a trusted network"
}

ensure_resource_profile_timer() {
  [ "$package_managed" = "1" ] || return 0
  unit=bitcoin-starter-stack-resource-profile.timer
  if [ "$(env_get BITCOIN_RESOURCE_PROFILE)" = compact ] || [ "$(env_get MONERO_RESOURCE_PROFILE)" = compact ] ||
    [ "$(env_get TARI_RESOURCE_PROFILE)" = compact ] || [ "$(env_get LITECOIN_RESOURCE_PROFILE)" = compact ] ||
    [ "$(env_get DOGECOIN_RESOURCE_PROFILE)" = compact ] || [ "$(env_get BITCOINCASH_RESOURCE_PROFILE)" = compact ] ||
    [ "$(env_get ZCASH_RESOURCE_PROFILE)" = compact ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable --now "$unit" >/dev/null 2>&1 ||
      echo "WARN  could not enable automatic post-sync resource limits; run: sudo systemctl enable --now $unit"
  else
    systemctl disable --now "$unit" >/dev/null 2>&1 || true
  fi
}

ensure_port_control_timer() {
  [ "$package_managed" = "1" ] || return 0
  unit=bitcoin-starter-stack-port-control.timer
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now "$unit" >/dev/null 2>&1 ||
    echo "WARN  could not enable LAN port controls; run: sudo systemctl enable --now $unit"
}

ensure_node_control_timer() {
  [ "$package_managed" = "1" ] || return 0
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now bitcoin-starter-stack-node-control.timer >/dev/null 2>&1 ||
    echo "WARN  could not enable node controls; run: sudo systemctl enable --now bitcoin-starter-stack-node-control.timer"
}

sync_node_runtime() {
  [ "$(docker inspect --format '{{.State.Running}}' dashboard 2>/dev/null || true)" = true ] || return 0
  local runtime='{}' node prefix enabled active
  for node in bitcoin monero tari litecoin dogecoin bitcoincash zcash; do
    prefix=$(printf '%s' "$node" | tr '[:lower:]' '[:upper:]')
    enabled=$(env_get "${prefix}_ENABLED")
    [ "$enabled" = 1 ] || continue
    active=$(env_get "${prefix}_ACTIVE")
    [ "$active" != 0 ] && active=true || active=false
    runtime=$(jq -c --arg node "$node" --argjson active "$active" '. + {($node):$active}' <<<"$runtime")
  done
  for _ in 1 2 3 4 5; do
    if printf '%s\n' "$runtime" | docker exec -i -u 1000 dashboard sh -c \
      'umask 077; cat > /state/.node-runtime.json.tmp; mv /state/.node-runtime.json.tmp /state/node-runtime.json' >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.2
  done
  return 1
}

prepare_linuxbrew_data_dirs() {
  [ "$package_managed" = brew ] && [ "$(uname -s)" = Linux ] || return 0
  local data_root=${BITCOIN_STACK_DATA_DIR:-} root_real node upper dir dir_real owner mode contents expected_owner expected_mode
  local tor_image commands='' mounts=()
  [ -n "$data_root" ] && [ -d "$data_root" ] && [ ! -L "$data_root" ] || {
    echo "Linuxbrew data directory is missing or is a symbolic link: $data_root" >&2
    return 1
  }
  root_real=$(readlink -f -- "$data_root") || return 1
  [ "$root_real" = "$data_root" ] || {
    echo "Linuxbrew data directory must use its canonical path: $root_real" >&2
    return 1
  }
  case "$data_root" in *:* | *,* | *$'\n'*) echo "Linuxbrew data directory contains unsupported characters." >&2; return 1 ;; esac

  for node in bitcoin monero tari litecoin dogecoin bitcoincash zcash; do
    upper=$(printf '%s' "$node" | tr '[:lower:]' '[:upper:]')
    dir=$(env_get "${upper}_DATA_DIR")
    expected_owner=1000:1000
    expected_mode=700
    if [ "$node" = zcash ]; then
      expected_owner=10001:1000
      expected_mode=750
    fi
    if [ "$dir" != "$data_root/$node" ]; then
      if [ ! -d "$dir" ] || [ -L "$dir" ] ||
        [ "$(stat -c '%u:%g' "$dir" 2>/dev/null)" != "$expected_owner" ] ||
        [ "$(stat -c '%a' "$dir" 2>/dev/null)" != "$expected_mode" ]; then
        echo "Custom $node data needs owner $expected_owner and mode $expected_mode: $dir" >&2
        printf 'Prepare it explicitly, then retry: sudo chown -R %s %q; sudo chmod %s %q\n' "$expected_owner" "$dir" "$expected_mode" "$dir" >&2
        return 1
      fi
      continue
    fi
    [ -d "$dir" ] && [ ! -L "$dir" ] || {
      echo "Default $node data directory is missing or is a symbolic link: $dir" >&2
      return 1
    }
    dir_real=$(readlink -f -- "$dir") || return 1
    [ "$dir_real" = "$root_real/$node" ] || {
      echo "Default $node data directory escapes the managed data root." >&2
      return 1
    }
    owner=$(stat -c '%u:%g' "$dir") || return 1
    mode=$(stat -c '%a' "$dir") || return 1
    [ "$owner" = "$expected_owner" ] && [ "$mode" = "$expected_mode" ] && continue
    contents=$(find "$dir" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null) || {
      echo "Linuxbrew cannot inspect $node data ownership: $dir" >&2
      return 1
    }
    if [ -n "$contents" ]; then
      echo "Linuxbrew will not change ownership or permissions of non-empty $node data: $dir" >&2
      printf 'Migrate it explicitly, then retry: sudo chown -R %s %q; sudo chmod %s %q\n' "$expected_owner" "$dir" "$expected_mode" "$dir" >&2
      return 1
    fi
    mounts+=( --mount "type=bind,src=$dir,dst=/node-data/$node" )
    commands+="chown $expected_owner /node-data/$node && chmod $expected_mode /node-data/$node && "
  done
  [ "${#mounts[@]}" -gt 0 ] || return 0
  tor_image=$(compose config --format json | jq -er '.services.tor.image') || return 1
  docker image inspect "$tor_image" >/dev/null 2>&1 || {
    echo "The local Tor image is required before Linuxbrew can prepare node data; run: $stack_command pull" >&2
    return 1
  }
  docker run --rm --network none --read-only --security-opt no-new-privileges \
    --cap-drop ALL --cap-add CHOWN --cap-add DAC_READ_SEARCH --cap-add FOWNER \
    --user 0:0 --entrypoint /bin/sh "${mounts[@]}" "$tor_image" -eu -c "${commands% && }" >/dev/null || {
    echo "Linuxbrew could not prepare the default node data directories." >&2
    return 1
  }
}

offline_up() {
  guard_package_containers || return 1
  for arg in "$@"; do
    case "$arg" in
      tor | bitcoin | monero | monero-wallet | tari | litecoin | dogecoin | bitcoincash | zcash | dashboard) ;;
      *) echo "up accepts service names only; image downloads are separate: $stack_command pull."; return 1 ;;
    esac
  done
  images_available || {
    echo "Start failed. Missing images? Run $stack_command pull, then retry."
    return 1
  }
  prepare_linuxbrew_data_dirs || return 1
  compose up -d --pull never --no-build "$@" || {
    echo "Start failed. Missing images? Run $stack_command pull, then retry."
    return 1
  }
  sync_node_runtime || {
    echo "Start succeeded, but the dashboard node state could not be synchronized."
    return 1
  }
}

pull_images() {
  compose pull
}

images_available() {
  local images image
  images=$(compose config --images) || return 1
  while IFS= read -r image; do
    [ -z "$image" ] || docker image inspect "$image" >/dev/null 2>&1 || return 1
  done <<<"$images"
}

status() {
  compose ps
  bad=0
  services="tor dashboard"
  [ "$(env_get BITCOIN_ENABLED)" != "0" ] && [ "$(env_get BITCOIN_ACTIVE)" != "0" ] && services="$services bitcoin"
  [ "$(env_get MONERO_ENABLED)" = "1" ] && [ "$(env_get MONERO_ACTIVE)" != "0" ] && services="$services monero monero-wallet"
  for node in TARI LITECOIN DOGECOIN BITCOINCASH ZCASH; do
    [ "$(env_get "${node}_ENABLED")" = 1 ] && [ "$(env_get "${node}_ACTIVE")" != 0 ] && services="$services $(printf '%s' "$node" | tr '[:upper:]' '[:lower:]')"
  done
  for svc in $services; do
    st=$(docker inspect "$svc" --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' 2>/dev/null || echo missing)
    case "$st" in
      "running healthy") echo "OK    $svc" ;;
      "running health: starting" | "running starting") echo "WAIT  $svc (health check warming up)" ;;
      *)
        echo "WARN  $svc: $st"
        bad=1
        ;;
    esac
  done
  return "$bad"
}

doctor() {
  echo "== Dependencies"
  for tool in docker jq openssl; do
    if command -v "$tool" >/dev/null; then echo "OK    $tool"; else echo "MISS  $tool"; fi
  done

  echo "== Config"
  if [ ! -f "$config_file" ]; then
    echo "MISS  config.json ($config_file)"
  elif [ ! -f "$env_file" ]; then
    echo "MISS  .env (run $stack_command apply)"
  elif [ "$config_file" -nt "$env_file" ]; then
    echo "WARN  config.json is newer than .env — run $stack_command apply"
  else
    echo "OK    config.json rendered into .env"
  fi
  if [ "$(env_get DASHBOARD_CONTROL)" = "1" ]; then
    if pgrep -f "stack upgrade-agent" >/dev/null 2>&1; then
      echo "OK    upgrade-agent (dashboard Upgrade button)"
    else
      echo "WARN  upgrade-agent not running — $stack_command up starts it"
    fi
  fi

  echo "== Disk"
  if [ "$(env_get BITCOIN_ENABLED)" != "0" ] && [ "$(env_get BITCOIN_ACTIVE)" != "0" ]; then
    data_dir=$(env_get BITCOIN_DATA_DIR)
    df -h "${data_dir:-.}" 2>/dev/null | tail -1 | awk '{printf "      Bitcoin: %s free of %s (%s used) at %s\n", $4, $2, $5, $6}'
  fi
  if [ "$(env_get MONERO_ENABLED)" = "1" ] && [ "$(env_get MONERO_ACTIVE)" != "0" ]; then
    data_dir=$(env_get MONERO_DATA_DIR)
    df -h "${data_dir:-.}" 2>/dev/null | tail -1 | awk '{printf "      Monero: %s free of %s (%s used) at %s\n", $4, $2, $5, $6}'
  fi
  for node in TARI LITECOIN DOGECOIN BITCOINCASH ZCASH; do
    [ "$(env_get "${node}_ENABLED")" = 1 ] || continue
    data_dir=$(env_get "${node}_DATA_DIR")
    label=$(printf '%s' "$node" | tr '[:upper:]' '[:lower:]')
    df -h "${data_dir:-.}" 2>/dev/null | tail -1 | awk -v node="$label" '{printf "      %s: %s free of %s (%s used) at %s\n", node, $4, $2, $5, $6}'
  done

  echo "== Containers"
  status || true

  echo "== Nodes"
  if [ "$(env_get BITCOIN_ENABLED)" != "0" ]; then
    if docker exec bitcoin bitcoin-cli -datadir=/data getblockchaininfo 2>/dev/null |
      jq -r '"      Bitcoin: blocks \(.blocks)/\(.headers)  progress \((.verificationprogress*100*100|round)/100)%  ibd \(.initialblockdownload)  pruned \(.pruned)"'; then :; else
      echo "      Bitcoin RPC unreachable (normal during startup; if it persists, check $stack_command logs bitcoin)"
    fi
  fi
  if [ "$(env_get MONERO_ENABLED)" = "1" ]; then
    if docker exec monero /usr/local/bin/monero-healthcheck >/dev/null 2>&1; then
      echo "      Monero RPC reachable"
    else
      echo "      Monero RPC unreachable (normal during startup; if it persists, check $stack_command logs monero)"
    fi
  fi
  for node in tari litecoin dogecoin bitcoincash zcash; do
    upper=$(printf '%s' "$node" | tr '[:lower:]' '[:upper:]')
    [ "$(env_get "${upper}_ENABLED")" = 1 ] || continue
    [ "$(env_get "${upper}_ACTIVE")" != 0 ] || continue
    if docker inspect "$node" --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' 2>/dev/null | grep -q '^running healthy$'; then
      echo "      $node RPC reachable"
    else
      echo "      $node unavailable (normal during startup; if it persists, check $stack_command logs $node)"
    fi
  done

  echo "== Tor"
  docker logs tor 2>&1 | grep "Bootstrapped" | tail -1 | sed 's/^/      /' || echo "      no bootstrap log yet"
  if [ "$(env_get DASHBOARD_ONION)" = "1" ]; then
    echo "      dashboard onion: $(docker exec tor cat /var/lib/tor/dashboard_onion/hostname 2>/dev/null || echo 'not provisioned yet')"
  fi
  if [ "$(env_get BITCOIN_ENABLED)" != "0" ] && [ "$(env_get BITCOIN_INBOUND_ONION)" = "1" ]; then
    echo "      node onion: $(docker exec bitcoin bitcoin-cli -datadir=/data getnetworkinfo 2>/dev/null | jq -r '.localaddresses[0].address // "not registered yet"')"
  fi
}

do_backup() {
  mkdir -p backups
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  [ -f "$config_file" ] && cp "$config_file" "$tmp/config.json"
  [ -f "$env_file" ] && cp "$env_file" "$tmp/.env"
  # bitcoind stores its inbound-onion key in the datadir
  data_dir=$(env_get BITCOIN_DATA_DIR)
  if [ -n "$data_dir" ] && [ -f "$data_dir/onion_v3_private_key" ]; then
    cp "$data_dir/onion_v3_private_key" "$tmp/" 2>/dev/null ||
      echo "WARN: node onion key not captured (unreadable — run backup as the node's user, uid 1000)"
  fi
  # the dashboard onion keys live in the tor volume
  compose cp tor:/var/lib/tor/dashboard_onion "$tmp/dashboard_onion" >/dev/null 2>&1 ||
    echo "WARN: dashboard onion keys not captured (is the tor container up?)"
  # UI-managed dashboard state is not otherwise re-derivable.
  compose cp dashboard:/state "$tmp/dashboard_state" >/dev/null 2>&1 ||
    echo "WARN: dashboard state not captured (is the dashboard container up?)"
  out="backups/stack-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
  tar czf "$out" -C "$tmp" .
  chmod 600 "$out"
  echo "Wrote $out (config, credentials, onion keys, dashboard state — chain data excluded, it's re-derivable)"
}

do_restore() {
  umask 077
  yes=0
  if [ "${1:-}" = "-y" ]; then
    yes=1
    shift
  fi
  if [ -z "${1:-}" ]; then
    echo "usage: ./stack restore [-y] <archive>"
    exit 1
  fi
  archive=$1
  if [ "$yes" != "1" ]; then
    printf "This overwrites config.json, .env, and onion keys from %s. Continue? [y/N] " "$archive"
    read -r reply
    case "$reply" in y | Y) ;; *)
      echo "Aborted."
      exit 1
      ;;
    esac
  fi
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  tar xzf "$archive" -C "$tmp"
  if [ -f "$tmp/config.json" ]; then
    replace_config "$tmp/config.json"
    echo "Restored config.json"
  fi
  if [ -f "$tmp/.env" ]; then
    chmod 600 "$env_file" 2>/dev/null || true
    cp "$tmp/.env" "$env_file" && chmod 600 "$env_file" && echo "Restored .env"
  fi
  data_dir=$(env_get BITCOIN_DATA_DIR)
  if [ -f "$tmp/onion_v3_private_key" ] && [ -n "$data_dir" ]; then
    cp "$tmp/onion_v3_private_key" "$data_dir/" && echo "Restored node onion key"
  fi
  if [ -d "$tmp/dashboard_onion" ]; then
    if compose cp "$tmp/dashboard_onion" tor:/var/lib/tor/ >/dev/null 2>&1 &&
      compose exec -u root tor chown -R tor:tor /var/lib/tor/dashboard_onion >/dev/null 2>&1; then
      compose restart tor >/dev/null
      echo "Restored dashboard onion keys (tor restarted)"
    else
      echo "WARN: could not restore dashboard onion keys (is the tor container up?)"
    fi
  fi
  if [ -d "$tmp/dashboard_state" ]; then
    # Extract as the dashboard user so private files keep the correct owner.
    if tar -cf - -C "$tmp/dashboard_state" . |
    compose exec -T -u 1000 dashboard tar -xof - -C /state; then
      echo "Restored dashboard state"
    else
      echo "ERROR: could not restore dashboard state (is the dashboard container up and writable by uid 1000?)"
      exit 1
    fi
  fi
  echo "Done. Apply with: $stack_command apply"
}

# One-command upgrade: fetch the latest release tag and apply it. Backs up
# first, only ever moves forward (never downgrades), and prints a rollback line.
do_upgrade() {
  if [ "$package_managed" = brew ]; then
    cat <<EOF
This installation is managed by Homebrew. Upgrade manually:
  $stack_command backup
  brew update
  brew upgrade bitcoin-starter-stack
  $stack_command pull
  $stack_command apply
EOF
    return 0
  fi
  if [ "$package_managed" = "1" ]; then
    cat <<EOF
This installation is managed by APT. Upgrade manually:
  $stack_command backup
  sudo apt update
  sudo apt install --only-upgrade bitcoin-starter-stack
  $stack_command pull
  $stack_command apply
EOF
    return 0
  fi
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Not a git checkout — upgrade by unpacking the latest release tarball:"
    echo "  https://github.com/VijitSingh97/bitcoin-starter-stack/releases/latest"
    exit 1
  fi
  current=$(cat "$stack_root/VERSION" 2>/dev/null || echo 0)
  echo "Current: v$current — fetching release tags..."
  origin=$(git remote get-url origin 2>/dev/null || true)
  case "$origin" in
    https://*)
      NO_PROXY='' no_proxy='' GIT_SSL_NO_VERIFY=false git \
        -c http.proxy=socks5h://172.29.0.25:9050 -c "http.$origin.proxy=socks5h://172.29.0.25:9050" \
        -c http.sslVerify=true -c "http.$origin.sslVerify=true" \
        -c http.followRedirects=false -c "http.$origin.followRedirects=false" \
        -c protocol.allow=never -c protocol.https.allow=always \
        fetch --tags --quiet "$origin" 2>/dev/null || {
        echo "git fetch through Tor failed — check Tor, then retry."
        exit 1
      }
      ;;
    /* | file:///*)
      git -c protocol.allow=never -c protocol.file.allow=always fetch --tags --quiet "$origin" 2>/dev/null || {
        echo "Local git fetch failed."
        exit 1
      }
      ;;
    *)
      echo "Upgrade requires an HTTPS origin (fetched through Tor) or an absolute local repository path."
      exit 1
      ;;
  esac
  latest=$(git tag --list --sort=-v:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | head -1)
  latest=${latest#v}
  [ -n "$latest" ] || {
    echo "No release tags found on the remote."
    exit 1
  }
  if [ "$latest" = "$current" ]; then
    echo "Already on the latest release (v$current). Nothing to do."
    return 0
  fi
  if [ "$(printf '%s\n%s\n' "$current" "$latest" | sort -V | tail -1)" != "$latest" ]; then
    echo "Installed v$current is newer than the latest release v$latest — nothing to do."
    return 0
  fi
  echo "Upgrading v$current -> v$latest"
  echo "== Backing up first (safety net)"
  do_backup
  echo "== Checking out v$latest"
  git checkout --quiet "v$latest" || {
    echo "checkout failed — commit or stash local changes to tracked files, then retry."
    exit 1
  }
  echo "== Applying (pull new images, recreate changed containers)"
  lock_config
  "$stack_root/configure.sh"
  images_available || pull_images
  offline_up
  unlock_config
  echo
  echo "Upgraded to v$latest. Verify with: ./stack status"
  echo "Roll back if needed:  git checkout \"v$current\" && ./stack apply"
}

# Host-side agent for the opt-in dashboard Upgrade button. The dashboard (which
# has no host/docker access) only drops a marker file in its state volume; this
# runs on the host, sees the marker, and performs the upgrade with the right
# privileges. up/apply manage it automatically via ensure_agent below; running
# it by hand just watches in the foreground.
upgrade_agent() {
  if [ "$package_managed" != "0" ]; then
    echo "Use the package manager to upgrade this installation." >&2
    exit 1
  fi
  echo "upgrade-agent: watching for dashboard host-control requests (Ctrl-C to stop)."
  echo "  Port closes require a dashboard password; upgrades also require dashboard.control=true."
  while true; do
    BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_dir" BITCOIN_STACK_CONFIG_DIR="$config_dir" \
      "$stack_root/scripts/node-control" || echo "upgrade-agent: node control check failed; still watching"
    BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_dir" BITCOIN_STACK_CONFIG_DIR="$config_dir" \
      "$stack_root/scripts/node-port-control" || echo "upgrade-agent: LAN port control check failed; still watching"
    if docker exec dashboard test -f /state/upgrade.request 2>/dev/null; then
      docker exec -u 1000 dashboard rm -f /state/upgrade.request 2>/dev/null || true
      if [ "$(env_get DASHBOARD_CONTROL)" = "1" ]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') upgrade-agent: request received — upgrading"
        # subshell so do_upgrade's exit on a bad fetch/checkout doesn't kill the agent
        (do_upgrade) || echo "upgrade-agent: upgrade did not complete (see above); still watching"
      else
        echo "upgrade-agent: ignored an upgrade request because dashboard.control is off"
      fi
    fi
    sleep 10
  done
}

# Keep the agent in sync with dashboard authentication: when set, start it
# detached and install a @reboot cron entry (no sudo needed); when empty, remove both. Skips
# entirely if the operator runs the agent under systemd (docs/operations.md).
# ponytail: cron can't restart a crashed agent until reboot — use the systemd
# unit if that matters to you.
ensure_agent() {
  if [ "$package_managed" = brew ]; then
    echo "Host controls and automatic post-sync caps: brew services start bitcoin-starter-stack"
    return 0
  fi
  [ "$package_managed" = "1" ] && return 0
  if [ "$(uname -s)" = Darwin ]; then
    echo "For persistent host controls on macOS, use the Homebrew installation; foreground: ./stack host-service"
    return 0
  fi
  if systemctl is-enabled bitcoin-stack-upgrade-agent >/dev/null 2>&1; then
    return 0 # managed by systemd — stay out of its way
  fi
  if [ -n "$(env_get DASHBOARD_PASSWORD)" ]; then
    line="@reboot sleep 60 && cd $PWD && ./stack upgrade-agent >> \$HOME/upgrade-agent.log 2>&1"
    (crontab -l 2>/dev/null | grep -vF "stack upgrade-agent"; echo "$line") | crontab - 2>/dev/null ||
      echo "WARN  could not install the upgrade-agent @reboot cron entry"
    if ! pgrep -f "stack upgrade-agent" >/dev/null 2>&1; then
      (setsid ./stack upgrade-agent >>"$HOME/upgrade-agent.log" 2>&1 </dev/null &)
      echo "upgrade-agent: started (log: ~/upgrade-agent.log; restarts on reboot via cron)"
    fi
  else
    if crontab -l 2>/dev/null | grep -qF "stack upgrade-agent"; then
      # grep -v exits 1 when ours is the only line — that's fine, write it empty
      crontab -l 2>/dev/null | { grep -vF "stack upgrade-agent" || true; } | crontab -
    fi
    if pkill -f "stack upgrade-agen[t]" 2>/dev/null; then
      echo "upgrade-agent: stopped (dashboard password is empty)"
    fi
  fi
}

host_service() {
  umask 077
  exec 7>"$state_dir/.host-service.lock"
  flock -n 7 || { echo "Another host service is already running." >&2; return 1; }
  trap 'exit 0' TERM INT
  local started=0 ticks=0 helper
  echo "host-service: waiting for saved configuration and Docker."
  while true; do
    if [ -r "$config_file" ] && docker info >/dev/null 2>&1; then
      if [ "$started" = 0 ]; then
        if (lock_config; "$stack_root/configure.sh" || exit 1; offline_up || exit 1; unlock_config); then
          started=1
          echo "host-service: supervising node controls and post-sync limits."
        fi
      fi
      if [ "$started" = 1 ]; then
        guard_package_containers || return 1
        for helper in node-control node-port-control; do
          BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_dir" BITCOIN_STACK_CONFIG_DIR="$config_dir" \
            "$stack_root/scripts/$helper" || echo "host-service: $helper check failed; will retry."
        done
        if [ "$ticks" = 0 ]; then
          BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_dir" \
            "$stack_root/scripts/node-resource-profile" || echo "host-service: resource check failed; will retry."
        fi
        ticks=$(((ticks + 1) % 6))
      fi
    fi
    sleep 10 &
    wait $! || true
  done
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

case "$cmd" in
  up)
    lock_config
    if [ ! -f "$env_file" ]; then
      "$stack_root/configure.sh"
    fi
    offline_up "$@"
    unlock_config
    ensure_resource_profile_timer
    ensure_port_control_timer
    ensure_node_control_timer
    ensure_agent
    ;;
  init) init ;;
  down) guard_package_containers && compose down "$@" ;;
  stop) guard_package_containers && compose stop "$@" ;;
  restart) guard_package_containers && compose restart "$@" ;;
  logs) guard_package_containers && compose logs -f --tail=100 "$@" ;;
  events) guard_package_containers && docker exec dashboard sh -c 'cat /state/events.log 2>/dev/null || echo "no events yet"' ;;
  apply)
    lock_config
    "$stack_root/configure.sh"
    offline_up
    unlock_config
    ensure_resource_profile_timer
    ensure_port_control_timer
    ensure_node_control_timer
    ensure_agent
    ;;
  apply-port-settings)
    lock_config
    "$stack_root/configure.sh"
    guard_package_containers
    compose up -d --pull never --no-build --no-deps tor dashboard || {
      echo "Port settings could not be applied with the installed images."
      exit 1
    }
    unlock_config
    ;;
  upgrade) do_upgrade ;;
  pull)
    lock_config
    "$stack_root/configure.sh"
    pull_images
    unlock_config
    ;;
  upgrade-agent) upgrade_agent ;;
  host-service) host_service ;;
  status) status ;;
  doctor) doctor ;;
  backup) guard_package_containers && do_backup ;;
  restore) guard_package_containers && do_restore "$@" ;;
  help | --help | -h) usage ;;
  *)
    echo "Unknown command: $cmd"
    usage
    exit 1
    ;;
esac
