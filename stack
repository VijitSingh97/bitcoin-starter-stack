#!/usr/bin/env bash
# Single entry point for operating the stack. Run ./stack help for usage.
set -euo pipefail
stack_root=${BITCOIN_STACK_ROOT:-$(cd "$(dirname "$0")" && pwd)}
state_dir=${BITCOIN_STACK_STATE_DIR:-$stack_root}
config_dir=${BITCOIN_STACK_CONFIG_DIR:-$state_dir}
config_file=$config_dir/config.json
env_file=$state_dir/.env
approved_config_file=$state_dir/.approved-config.json
approved_env_file=$state_dir/.approved.env
stack_command=${BITCOIN_STACK_COMMAND:-./stack}
package_managed=${BITCOIN_STACK_PACKAGE_MANAGED:-0}
legacy_project=bitcoin-starter-stack
fresh_project='node-manager-source'
case "$package_managed" in
  brew) legacy_project=bitcoin-starter-stack-brew; fresh_project='node-manager-brew' ;;
  1 | apt) legacy_project=bitcoin-starter-stack-apt; fresh_project='node-manager-apt' ;;
esac
project_name=${BITCOIN_STACK_PROJECT_NAME:-}
if [ -z "$project_name" ] && [ -f "$env_file" ]; then
  project_name=$(sed -n 's/^COMPOSE_PROJECT_NAME=//p' "$env_file" 2>/dev/null | tail -n 1)
fi
if [ -z "$project_name" ]; then
  if [ -f "$env_file" ]; then project_name=$legacy_project; else project_name=$fresh_project; fi
fi
export BITCOIN_STACK_PROJECT_NAME="$project_name"
config_lock_owned=0

lock_config() {
  [ "${BITCOIN_STACK_CONFIG_LOCK_HELD:-0}" != 1 ] || return 0
  mkdir -p "$state_dir"
  exec 8>"$state_dir/.config.lock"
  flock 8
  export BITCOIN_STACK_CONFIG_LOCK_HELD=1
  config_lock_owned=1
}

unlock_config() {
  [ "$config_lock_owned" = 1 ] || return 0
  flock -u 8
  unset BITCOIN_STACK_CONFIG_LOCK_HELD
  config_lock_owned=0
}

replace_config() {
  local source=$1 target
  mkdir -p "$state_dir" "$config_dir"
  lock_config
  target=$(mktemp "$config_dir/.config.write.XXXXXX")
  chmod 600 "$target"
  cat "$source" >"$target"
  mv "$target" "$config_file"
  unlock_config
}

approve_current_config() {
  local source=${1:-$config_file} target env_target config_backup env_backup
  [ -f "$env_file" ] || {
    echo "Cannot approve configuration before it has been rendered." >&2
    return 1
  }
  target=$(mktemp "$state_dir/.approved-config.write.XXXXXX") || return 1
  env_target=$(mktemp "$state_dir/.approved-env.write.XXXXXX") || {
    rm -f "$target"
    return 1
  }
  if [ -f "$source" ]; then
    jq -S . "$source" >"$target" || {
      rm -f "$target" "$env_target"
      return 1
    }
  else
    printf '{}\n' >"$target"
  fi
  if ! cp "$env_file" "$env_target" || ! chmod 600 "$target" "$env_target"; then
    rm -f "$target" "$env_target"
    return 1
  fi
  config_backup=$(mktemp "$state_dir/.approved-config.backup.XXXXXX") || {
    rm -f "$target" "$env_target"
    return 1
  }
  env_backup=$(mktemp "$state_dir/.approved-env.backup.XXXXXX") || {
    rm -f "$target" "$env_target" "$config_backup"
    return 1
  }
  if [ -f "$approved_config_file" ] && ! cp "$approved_config_file" "$config_backup"; then
    rm -f "$target" "$env_target" "$config_backup" "$env_backup"
    return 1
  fi
  if [ -f "$approved_env_file" ] && ! cp "$approved_env_file" "$env_backup"; then
    rm -f "$target" "$env_target" "$config_backup" "$env_backup"
    return 1
  fi
  mv "$target" "$approved_config_file" || {
    rm -f "$target" "$env_target" "$config_backup" "$env_backup"
    return 1
  }
  mv "$env_target" "$approved_env_file" || {
    if [ -s "$config_backup" ]; then cp "$config_backup" "$approved_config_file"; else rm -f "$approved_config_file"; fi
    if [ -s "$env_backup" ]; then cp "$env_backup" "$approved_env_file"; else rm -f "$approved_env_file"; fi
    rm -f "$config_backup" "$env_backup"
    return 1
  }
  rm -f "$config_backup" "$env_backup"
}

approve_existing_runtime() {
  local source
  source=$(mktemp "$state_dir/.approved-runtime.XXXXXX")
  printf 'null\n' >"$source"
  approve_current_config "$source"
  rm -f "$source"
}

config_matches_approved() {
  [ -f "$approved_config_file" ] || return 1
  if [ ! -f "$config_file" ]; then
    jq -e 'type == "object" and length == 0' "$approved_config_file" >/dev/null
    return
  fi
  diff -q <(jq -S . "$config_file") "$approved_config_file" >/dev/null 2>&1
}

render_config_file() {
  local source=$1 temporary_config_dir
  if [ "$source" = "$config_file" ]; then
    "$stack_root/configure.sh"
    return
  fi
  temporary_config_dir=$(mktemp -d "$state_dir/.approved-config.XXXXXX")
  cp "$source" "$temporary_config_dir/config.json"
  BITCOIN_STACK_CONFIG_DIR="$temporary_config_dir" "$stack_root/configure.sh"
  rm -f "$temporary_config_dir/config.json"
  rmdir "$temporary_config_dir"
}

render_current_config() {
  render_config_file "$config_file"
}

render_approved_config() {
  [ ! -f "$approved_env_file" ] || cp "$approved_env_file" "$env_file"
  if jq -e 'type == "null"' "$approved_config_file" >/dev/null; then
    return
  fi
  render_config_file "$approved_config_file"
  approve_current_config "$approved_config_file"
}

prepare_config_for_start() {
  config_was_applied=0
  if [ ! -f "$approved_config_file" ]; then
    if [ -f "$env_file" ]; then
      approve_existing_runtime
    else
      render_current_config
      approve_current_config
      config_was_applied=1
      return
    fi
  fi
  if config_matches_approved; then
    if [ -f "$config_file" ]; then
      render_current_config
      approve_current_config
    else
      cp "$approved_env_file" "$env_file"
      chmod 600 "$env_file"
    fi
    return
  fi

  echo "Config change detected."
  reply=n
  if [ -t 0 ] || [ "${BITCOIN_STACK_INTERACTIVE:-0}" = 1 ]; then
    printf "Run new config? [y/N] "
    read -r reply || true
  else
    echo "Keeping the last approved config. Run $stack_command apply to approve the pending change."
  fi
  case "$reply" in
    y | Y)
      render_current_config
      approve_current_config
      config_was_applied=1
      ;;
    *)
      render_approved_config
      ;;
  esac
}
cd "$state_dir"

compose() {
  local -a runner=(docker compose)
  if [ -n "${BITCOIN_STACK_COMPOSE_TIMEOUT_SECONDS:-}" ]; then
    [[ "$BITCOIN_STACK_COMPOSE_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] &&
      [ "$BITCOIN_STACK_COMPOSE_TIMEOUT_SECONDS" -ge 1 ] &&
      [ "$BITCOIN_STACK_COMPOSE_TIMEOUT_SECONDS" -le 3600 ] || {
      echo "Invalid Compose timeout." >&2
      return 1
    }
    runner=(timeout --foreground "$BITCOIN_STACK_COMPOSE_TIMEOUT_SECONDS" docker compose)
  fi
  if [ "$state_dir" = "$stack_root" ]; then
    "${runner[@]}" --project-name "$project_name" "$@"
  else
    local compose_file compose_files=()
    compose_file=$(env_get COMPOSE_FILE)
    compose_file=${compose_file:-docker-compose.yml}
    IFS=: read -ra compose_files <<<"$compose_file"
    local compose_args=()
    for compose_file in "${compose_files[@]}"; do
      case "$compose_file" in
        docker-compose.yml | docker-compose.tari-wallet.yml | docker-compose.rpc.yml | docker-compose.monero-rpc.yml | docker-compose.monero-zmq.yml | docker-compose.tari-grpc.yml | docker-compose.litecoin-rpc.yml | docker-compose.dogecoin-rpc.yml | docker-compose.bitcoincash-rpc.yml | docker-compose.zcash-rpc.yml)
          compose_args+=( -f "$stack_root/$compose_file" )
          ;;
        *)
          echo "Unsupported package Compose file: $compose_file" >&2
          return 1
          ;;
      esac
    done
    "${runner[@]}" --project-name "$project_name" \
      --project-directory "$state_dir" --env-file "$env_file" \
      "${compose_args[@]}" "$@"
  fi
}

container_id() {
  local output
  local -a ids
  output=$(docker ps -aq \
    --filter "label=com.docker.compose.project=$project_name" \
    --filter "label=com.docker.compose.service=$1") || return 1
  ids=()
  [ -z "$output" ] || mapfile -t ids <<<"$output"
  if [ "${#ids[@]}" -gt 1 ]; then
    echo "Multiple $1 containers use the $project_name project identity." >&2
    return 1
  fi
  [ "${#ids[@]}" = 0 ] || printf '%s\n' "${ids[0]}"
}

guard_package_containers() {
  [ "$package_managed" != 0 ] || return 0
  local service id config working_dir
  for service in tor bitcoin monero monero-wallet tari tari-wallet litecoin dogecoin bitcoincash zcash dashboard; do
    if ! id=$(container_id "$service"); then
      echo "Existing $service container ownership could not be queried; package mode will not replace it." >&2
      return 1
    fi
    [ -n "$id" ] || continue
    config=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files" }}' "$id" 2>/dev/null) || {
      echo "Existing $service container ownership could not be verified; package mode will not replace it." >&2
      return 1
    }
    case ",$config," in
      *",$stack_root/docker-compose.yml,"*) ;;
      *)
        echo "Existing $service container belongs to another installation; package mode will not replace it." >&2
        echo "Keep the source deployment or stop it and plan a manual migration; see docs/operations.md." >&2
        return 1
        ;;
    esac
    working_dir=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir" }}' "$id" 2>/dev/null) || return 1
    if [ "$working_dir" != "$state_dir" ]; then
      echo "Existing $service container belongs to another installation; this installation will not replace it." >&2
      return 1
    fi
  done
}

usage() {
  cat <<EOF
Usage: $stack_command <command> [args]

  up | down | restart [svc]  Start / stop / restart the stack (or one service)
  pull                       Download container images using host Docker settings
  init                       Create the default config, download images, and start
  logs [svc]                 Follow logs (all services, or one)
  events                     Incident history (down/recovered, failed pings) — survives restarts
  apply                      Re-render .env from config.json and apply changes
  upgrade                    Show manual APT, Homebrew, and GitHub update steps
  upgrade-agent              Compatibility alias for host-service
  host-service               Supervise configured nodes and host controls
  status                     Container + health summary; warns on anything down
  doctor                     Read-only health report (deps, disk, sync, tor)
  backup                     Save config, credentials, and onion keys to backups/
  restore [-y] <archive>     Restore a backup archive (prompts before overwrite)
  help                       This text
EOF
}

env_get() { sed -n "s/^$1=//p" "$env_file" 2>/dev/null || true; }

print_selected_credentials() {
  echo "Generated credentials:"
  if [ -n "$(env_get DASHBOARD_PASSWORD)" ]; then
    echo "  Dashboard — username: admin  password: $(env_get DASHBOARD_PASSWORD)"
  else
    echo "  Dashboard password — default off; any password saved in Settings still applies"
  fi
  for node in bitcoin monero litecoin dogecoin bitcoincash zcash; do
    upper=$(printf '%s' "$node" | tr '[:lower:]' '[:upper:]')
    [ "$(env_get "${upper}_ENABLED")" = 1 ] || continue
    label=$node
    case "$node" in
      bitcoin) label=Bitcoin ;;
      monero) label=Monero ;;
      litecoin) label=Litecoin ;;
      dogecoin) label=Dogecoin ;;
      bitcoincash) label="Bitcoin Cash" ;;
      zcash) label=Zcash ;;
    esac
    echo "  $label RPC — username: $(env_get "${upper}_RPC_USER")  password: $(env_get "${upper}_RPC_PASSWORD")"
  done
  if [ "$(env_get TARI_ENABLED)" = 1 ]; then
    echo "  Tari gRPC — no password; keep LAN exposure on a trusted network"
  fi
}


init() {
  umask 077
  for tool in jq openssl; do
    command -v "$tool" >/dev/null || {
      echo "$tool is required; install it with your host package manager."
      exit 1
    }
  done
  migrate_legacy_upgrade_agent

  if [ ! -f "$config_file" ]; then
    config_source=$(mktemp)
    if [ "$package_managed" = "0" ]; then
      printf '%s\n' '{"bitcoin":{"enabled":true},"dashboard":{"password":"","bind_ip":"auto","launch_at_boot":false}}' >"$config_source"
    else
      printf '%s\n' '{"bitcoin":{"enabled":true,"resource_profile":"compact"},"dashboard":{"password":"","bind_ip":"auto","launch_at_boot":false}}' >"$config_source"
    fi
    replace_config "$config_source"
    rm -f "$config_source"
    echo "Created a Bitcoin-only pruned configuration."
  else
    echo "Using the existing config.json."
  fi

  lock_config
  previous_env=$(mktemp "$state_dir/.env.before-init.XXXXXX")
  previous_approved_config=$(mktemp "$state_dir/.approved-config.before-init.XXXXXX")
  previous_approved_env=$(mktemp "$state_dir/.approved-env.before-init.XXXXXX")
  had_previous_env=0
  had_previous_approved_config=0
  had_previous_approved_env=0
  if [ -f "$env_file" ]; then cp "$env_file" "$previous_env"; had_previous_env=1; fi
  if [ -f "$approved_config_file" ]; then cp "$approved_config_file" "$previous_approved_config"; had_previous_approved_config=1; fi
  if [ -f "$approved_env_file" ]; then cp "$approved_env_file" "$previous_approved_env"; had_previous_approved_env=1; fi
  render_current_config
  if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
    if [ "$had_previous_env" = 1 ]; then cp "$previous_env" "$env_file"; else rm -f "$env_file"; fi
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    unlock_config
    echo "Configuration was saved, but Docker is not ready. Start Docker, then run $stack_command init again." >&2
    return 1
  fi
  if ! guard_package_containers || { ! images_available && ! pull_images --policy missing; }; then
    if [ "$had_previous_env" = 1 ]; then cp "$previous_env" "$env_file"; else rm -f "$env_file"; fi
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    unlock_config
    echo "Initialization did not start; the previous runtime settings remain selected." >&2
    return 1
  fi
  if ! offline_up; then
    rollback_failed=0
    if [ "$had_previous_env" = 1 ]; then
      cp "$previous_env" "$env_file"
      offline_up >/dev/null 2>&1 || rollback_failed=1
    else
      compose down >/dev/null 2>&1 || rollback_failed=1
      rm -f "$env_file"
    fi
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    unlock_config
    [ "$rollback_failed" = 0 ] || echo "Initialization failed, and the previous runtime could not be fully restored." >&2
    echo "Initialization did not start; the previous runtime settings remain selected." >&2
    return 1
  fi
  if ! approve_current_config; then
    rollback_failed=0
    if [ "$had_previous_env" = 1 ]; then
      cp "$previous_env" "$env_file"
      offline_up >/dev/null 2>&1 || rollback_failed=1
    else
      compose down >/dev/null 2>&1 || rollback_failed=1
      rm -f "$env_file"
    fi
    if [ "$had_previous_approved_config" = 1 ]; then cp "$previous_approved_config" "$approved_config_file"; else rm -f "$approved_config_file"; fi
    if [ "$had_previous_approved_env" = 1 ]; then cp "$previous_approved_env" "$approved_env_file"; else rm -f "$approved_env_file"; fi
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    unlock_config
    [ "$rollback_failed" = 0 ] || echo "Initialization approval failed, and the previous runtime could not be fully restored." >&2
    echo "Initialization approval failed; the new runtime was not retained." >&2
    return 1
  fi
  rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
  unlock_config
  ensure_resource_profile_timer
  ensure_port_control_timer
  ensure_node_control_timer
  ensure_agent
  echo "Nodes: $(env_get COMPOSE_PROFILES)"
  echo "Started. Dashboard: http://$(env_get DASHBOARD_BIND_IP):$(env_get DASHBOARD_PORT)/"
  print_selected_credentials
  echo "Edit config.json before init for custom first-boot settings, or use the dashboard after startup."
}

ensure_resource_profile_timer() {
  [ "$package_managed" = "1" ] || return 0
  unit=bitcoin-starter-stack-resource-profile.timer
  if [ "$(env_get BITCOIN_RESOURCE_PROFILE)" = compact ] || [ "$(env_get MONERO_RESOURCE_PROFILE)" = compact ] ||
    [ "$(env_get TARI_RESOURCE_PROFILE)" = compact ] || [ "$(env_get LITECOIN_RESOURCE_PROFILE)" = compact ] ||
    [ "$(env_get DOGECOIN_RESOURCE_PROFILE)" = compact ] || [ "$(env_get BITCOINCASH_RESOURCE_PROFILE)" = compact ] ||
    [ "$(env_get ZCASH_RESOURCE_PROFILE)" = compact ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable --now "$unit" >/dev/null 2>&1 ||
      echo "WARN  could not enable automatic post-sync resource limits; run: sudo systemctl enable --now $unit"
  else
    systemctl disable --now "$unit" >/dev/null 2>&1 || true
  fi
}

ensure_port_control_timer() {
  [ "$package_managed" = "1" ] || return 0
  unit=bitcoin-starter-stack-port-control.timer
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now "$unit" >/dev/null 2>&1 ||
    echo "WARN  could not enable LAN port controls; run: sudo systemctl enable --now $unit"
}

ensure_node_control_timer() {
  [ "$package_managed" = "1" ] || return 0
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now bitcoin-starter-stack-node-control.timer >/dev/null 2>&1 ||
    echo "WARN  could not enable node controls; run: sudo systemctl enable --now bitcoin-starter-stack-node-control.timer"
}

sync_node_runtime() {
  local dashboard_id
  dashboard_id=$(container_id dashboard)
  [ -n "$dashboard_id" ] || return 0
  [ "$(docker inspect --format '{{.State.Running}}' "$dashboard_id" 2>/dev/null || true)" = true ] || return 0
  local runtime='{}' node prefix enabled active
  for node in bitcoin monero tari litecoin dogecoin bitcoincash zcash; do
    prefix=$(printf '%s' "$node" | tr '[:lower:]' '[:upper:]')
    enabled=$(env_get "${prefix}_ENABLED")
    [ "$enabled" = 1 ] || continue
    active=$(env_get "${prefix}_ACTIVE")
    [ "$active" != 0 ] && active=true || active=false
    runtime=$(jq -c --arg node "$node" --argjson active "$active" '. + {($node):$active}' <<<"$runtime")
  done
  for _ in 1 2 3 4 5; do
    if printf '%s\n' "$runtime" | compose exec -T -u 1000 dashboard sh -c \
      'umask 077; cat > /state/.node-runtime.json.tmp; mv /state/.node-runtime.json.tmp /state/node-runtime.json' >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.2
  done
  return 1
}

prepare_linuxbrew_data_dirs() {
  [ "$package_managed" = brew ] && [ "$(uname -s)" = Linux ] || return 0
  local data_root=${BITCOIN_STACK_DATA_DIR:-} root_real node upper dir dir_real owner mode contents expected_owner expected_mode
  local tor_image commands='' mounts=()
  if [ -z "$data_root" ] || [ ! -d "$data_root" ] || [ -L "$data_root" ]; then
    echo "Linuxbrew data directory is missing or is a symbolic link: $data_root" >&2
    return 1
  fi
  root_real=$(readlink -f -- "$data_root") || return 1
  [ "$root_real" = "$data_root" ] || {
    echo "Linuxbrew data directory must use its canonical path: $root_real" >&2
    return 1
  }
  case "$data_root" in *:* | *,* | *$'\n'*) echo "Linuxbrew data directory contains unsupported characters." >&2; return 1 ;; esac

  for node in bitcoin monero tari litecoin dogecoin bitcoincash zcash; do
    upper=$(printf '%s' "$node" | tr '[:lower:]' '[:upper:]')
    dir=$(env_get "${upper}_DATA_DIR")
    expected_owner=1000:1000
    expected_mode=700
    if [ "$node" = zcash ]; then
      expected_owner=10001:1000
      expected_mode=750
    fi
    if [ "$dir" != "$data_root/$node" ]; then
      if [ ! -d "$dir" ] || [ -L "$dir" ] ||
        [ "$(stat -c '%u:%g' "$dir" 2>/dev/null)" != "$expected_owner" ] ||
        [ "$(stat -c '%a' "$dir" 2>/dev/null)" != "$expected_mode" ]; then
        echo "Custom $node data needs owner $expected_owner and mode $expected_mode: $dir" >&2
        printf 'Prepare it explicitly, then retry: sudo chown -R %s %q; sudo chmod %s %q\n' "$expected_owner" "$dir" "$expected_mode" "$dir" >&2
        return 1
      fi
      continue
    fi
    if [ ! -d "$dir" ] || [ -L "$dir" ]; then
      echo "Default $node data directory is missing or is a symbolic link: $dir" >&2
      return 1
    fi
    dir_real=$(readlink -f -- "$dir") || return 1
    [ "$dir_real" = "$root_real/$node" ] || {
      echo "Default $node data directory escapes the managed data root." >&2
      return 1
    }
    owner=$(stat -c '%u:%g' "$dir") || return 1
    mode=$(stat -c '%a' "$dir") || return 1
    [ "$owner" = "$expected_owner" ] && [ "$mode" = "$expected_mode" ] && continue
    contents=$(find "$dir" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null) || {
      echo "Linuxbrew cannot inspect $node data ownership: $dir" >&2
      return 1
    }
    if [ -n "$contents" ]; then
      echo "Linuxbrew will not change ownership or permissions of non-empty $node data: $dir" >&2
      printf 'Migrate it explicitly, then retry: sudo chown -R %s %q; sudo chmod %s %q\n' "$expected_owner" "$dir" "$expected_mode" "$dir" >&2
      return 1
    fi
    mounts+=( --mount "type=bind,src=$dir,dst=/node-data/$node" )
    commands+="chown $expected_owner /node-data/$node && chmod $expected_mode /node-data/$node && "
  done
  [ "${#mounts[@]}" -gt 0 ] || return 0
  tor_image=$(compose config --format json | jq -er '.services.tor.image') || return 1
  docker image inspect "$tor_image" >/dev/null 2>&1 || {
    echo "The local Tor image is required before Linuxbrew can prepare node data; run: $stack_command pull" >&2
    return 1
  }
  docker run --rm --network none --read-only --security-opt no-new-privileges \
    --cap-drop ALL --cap-add CHOWN --cap-add DAC_READ_SEARCH --cap-add FOWNER \
    --user 0:0 --entrypoint /bin/sh "${mounts[@]}" "$tor_image" -eu -c "${commands% && }" >/dev/null || {
    echo "Linuxbrew could not prepare the default node data directories." >&2
    return 1
  }
}

offline_up() {
  guard_package_containers || return 1
  for arg in "$@"; do
    case "$arg" in
      tor | bitcoin | monero | monero-wallet | tari | tari-wallet | litecoin | dogecoin | bitcoincash | zcash | dashboard) ;;
      *) echo "up accepts service names only; image downloads are separate: $stack_command pull."; return 1 ;;
    esac
  done
  images_available || {
    echo "Start failed. Missing images? Run $stack_command pull, then retry."
    return 1
  }
  prepare_linuxbrew_data_dirs || return 1
  compose up -d --pull never --no-build "$@" || {
    echo "Start failed. Missing images? Run $stack_command pull, then retry."
    return 1
  }
  sync_node_runtime || {
    echo "Start succeeded, but the dashboard node state could not be synchronized."
    return 1
  }
}

pull_images() {
  compose pull "$@"
}

running_package_services() {
  local service id running
  for service in tor bitcoin monero monero-wallet tari tari-wallet litecoin dogecoin bitcoincash zcash dashboard; do
    if ! id=$(container_id "$service"); then
      echo "Running $service container state could not be queried." >&2
      return 1
    fi
    [ -n "$id" ] || continue
    if ! running=$(docker inspect --format '{{.State.Running}}' "$id" 2>/dev/null); then
      echo "Running $service container state could not be inspected." >&2
      return 1
    fi
    case "$running" in
      true) printf '%s\n' "$service" ;;
      false) ;;
      *) echo "Running $service container returned an invalid state." >&2; return 1 ;;
    esac
  done
}

render_package_upgrade_env() {
  local version target
  version=$(cat "$stack_root/VERSION") || return 1
  case "$version" in
    '' | [!0-9]* | *[!A-Za-z0-9.-]* | *[.-]) echo "Installed package version is invalid." >&2; return 1 ;;
  esac
  [ "${#version}" -le 128 ] || { echo "Installed package version is invalid." >&2; return 1; }
  target=$(mktemp "$state_dir/.env.package-upgrade.XXXXXX") || return 1
  if ! awk -v version="$version" '
    /^STACK_VERSION=/ { print "STACK_VERSION=" version; found++; next }
    { print }
    END { if (found != 1) exit 1 }
  ' "$approved_env_file" >"$target"; then
    rm -f "$target"
    echo "Approved runtime is missing a single package version field." >&2
    return 1
  fi
  chmod 600 "$target"
  mv "$target" "$env_file"
}

restore_package_upgrade_state() {
  cp "$1" "$env_file"
  cp "$2" "$approved_config_file"
  cp "$3" "$approved_env_file"
  chmod 600 "$env_file" "$approved_config_file" "$approved_env_file"
}

mark_package_upgrade_pending() {
  touch "$state_dir/.package-upgrade-pending"
  chmod 600 "$state_dir/.package-upgrade-pending"
}

package_upgrade() {
  local service current package_upgrade_failed running_output
  local previous_env previous_approved_config previous_approved_env
  local -a running_before running_now upgrade_services
  case "$package_managed" in 1 | apt) ;; *) echo "package-upgrade is available only to the APT package." >&2; return 1 ;; esac
  [ -s "$env_file" ] && [ -s "$approved_config_file" ] && [ -s "$approved_env_file" ] || return 0
  if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
    echo "Docker is not ready; the package is installed but its containers were not updated." >&2
    mark_package_upgrade_pending
    return 1
  fi

  lock_config
  guard_package_containers || { mark_package_upgrade_pending; unlock_config; return 1; }
  if ! running_output=$(running_package_services); then
    mark_package_upgrade_pending
    unlock_config
    return 1
  fi
  running_before=()
  [ -z "$running_output" ] || mapfile -t running_before <<<"$running_output"
  if [ "${#running_before[@]}" = 0 ]; then
    unlock_config
    return 0
  fi

  previous_env=$(mktemp "$state_dir/.env.before-package-upgrade.XXXXXX")
  previous_approved_config=$(mktemp "$state_dir/.approved-config.before-package-upgrade.XXXXXX")
  previous_approved_env=$(mktemp "$state_dir/.approved-env.before-package-upgrade.XXXXXX")
  cp "$env_file" "$previous_env"
  cp "$approved_config_file" "$previous_approved_config"
  cp "$approved_env_file" "$previous_approved_env"
  chmod 600 "$previous_env" "$previous_approved_config" "$previous_approved_env"

  package_upgrade_failed=0
  if ! render_package_upgrade_env; then
    package_upgrade_failed=1
  elif ! BITCOIN_STACK_COMPOSE_TIMEOUT_SECONDS=1800 pull_images "${running_before[@]}"; then
    package_upgrade_failed=1
  fi
  if [ "$package_upgrade_failed" = 1 ]; then
    restore_package_upgrade_state "$previous_env" "$previous_approved_config" "$previous_approved_env"
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    mark_package_upgrade_pending
    unlock_config
    echo "Container activation failed before any running service was changed." >&2
    return 1
  fi

  guard_package_containers || {
    restore_package_upgrade_state "$previous_env" "$previous_approved_config" "$previous_approved_env"
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    mark_package_upgrade_pending
    unlock_config
    return 1
  }
  if ! running_output=$(running_package_services); then
    restore_package_upgrade_state "$previous_env" "$previous_approved_config" "$previous_approved_env"
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    mark_package_upgrade_pending
    unlock_config
    return 1
  fi
  running_now=()
  [ -z "$running_output" ] || mapfile -t running_now <<<"$running_output"
  upgrade_services=()
  for service in "${running_before[@]}"; do
    for current in "${running_now[@]}"; do
      if [ "$service" = "$current" ]; then upgrade_services+=("$service"); break; fi
    done
  done
  if [ "${#upgrade_services[@]}" = 0 ]; then
    if ! approve_current_config "$approved_config_file"; then
      restore_package_upgrade_state "$previous_env" "$previous_approved_config" "$previous_approved_env"
      rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
      mark_package_upgrade_pending
      unlock_config
      return 1
    fi
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env" "$state_dir/.package-upgrade-pending"
    unlock_config
    ensure_resource_profile_timer
    ensure_port_control_timer
    ensure_node_control_timer
    return 0
  fi

  if ! approve_current_config "$approved_config_file"; then
    restore_package_upgrade_state "$previous_env" "$previous_approved_config" "$previous_approved_env"
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    mark_package_upgrade_pending
    unlock_config
    return 1
  fi

  if ! compose up -d --pull never --no-build --no-deps "${upgrade_services[@]}"; then
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    mark_package_upgrade_pending
    unlock_config
    echo "The new containers could not be fully activated; no automatic image downgrade was attempted." >&2
    echo "Check the current state with: sudo bitcoin-stack status" >&2
    echo "Restart the services interrupted by activation with: sudo bitcoin-stack up ${upgrade_services[*]}" >&2
    echo "Retry activation with: sudo bitcoin-stack package-upgrade" >&2
    return 1
  fi
  sync_node_runtime || echo "WARN  containers were updated, but dashboard node state will synchronize on its next refresh." >&2
  rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env" "$state_dir/.package-upgrade-pending"
  unlock_config
  ensure_resource_profile_timer
  ensure_port_control_timer
  ensure_node_control_timer
  echo "Updated the running Node Manager services."
}

images_available() {
  local images image
  images=$(compose config --images) || return 1
  while IFS= read -r image; do
    [ -z "$image" ] || docker image inspect "$image" >/dev/null 2>&1 || return 1
  done <<<"$images"
}

status() {
  compose ps
  bad=0
  services="tor dashboard"
  [ "$(env_get BITCOIN_ENABLED)" != "0" ] && [ "$(env_get BITCOIN_ACTIVE)" != "0" ] && services="$services bitcoin"
  [ "$(env_get MONERO_ENABLED)" = "1" ] && [ "$(env_get MONERO_ACTIVE)" != "0" ] && services="$services monero monero-wallet"
  for node in TARI LITECOIN DOGECOIN BITCOINCASH ZCASH; do
    [ "$(env_get "${node}_ENABLED")" = 1 ] && [ "$(env_get "${node}_ACTIVE")" != 0 ] && services="$services $(printf '%s' "$node" | tr '[:upper:]' '[:lower:]')"
  done
  for svc in $services; do
    id=$(container_id "$svc")
    if [ -n "$id" ]; then
      st=$(docker inspect "$id" --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' 2>/dev/null || echo missing)
    else
      st=missing
    fi
    case "$st" in
      "running healthy") echo "OK    $svc" ;;
      "running health: starting" | "running starting") echo "WAIT  $svc (health check warming up)" ;;
      *)
        echo "WARN  $svc: $st"
        bad=1
        ;;
    esac
  done
  return "$bad"
}

doctor() {
  echo "== Dependencies"
  for tool in docker jq openssl; do
    if command -v "$tool" >/dev/null; then echo "OK    $tool"; else echo "MISS  $tool"; fi
  done

  echo "== Config"
  if [ ! -f "$config_file" ]; then
    echo "MISS  config.json ($config_file)"
  elif [ ! -f "$env_file" ]; then
    echo "MISS  .env (run $stack_command apply)"
  elif [ "$config_file" -nt "$env_file" ]; then
    echo "WARN  config.json is newer than .env — run $stack_command apply"
  else
    echo "OK    config.json rendered into .env"
  fi
  echo "== Disk"
  if [ "$(env_get BITCOIN_ENABLED)" != "0" ] && [ "$(env_get BITCOIN_ACTIVE)" != "0" ]; then
    data_dir=$(env_get BITCOIN_DATA_DIR)
    df -h "${data_dir:-.}" 2>/dev/null | tail -1 | awk '{printf "      Bitcoin: %s free of %s (%s used) at %s\n", $4, $2, $5, $6}'
  fi
  if [ "$(env_get MONERO_ENABLED)" = "1" ] && [ "$(env_get MONERO_ACTIVE)" != "0" ]; then
    data_dir=$(env_get MONERO_DATA_DIR)
    df -h "${data_dir:-.}" 2>/dev/null | tail -1 | awk '{printf "      Monero: %s free of %s (%s used) at %s\n", $4, $2, $5, $6}'
  fi
  for node in TARI LITECOIN DOGECOIN BITCOINCASH ZCASH; do
    [ "$(env_get "${node}_ENABLED")" = 1 ] || continue
    data_dir=$(env_get "${node}_DATA_DIR")
    label=$(printf '%s' "$node" | tr '[:upper:]' '[:lower:]')
    df -h "${data_dir:-.}" 2>/dev/null | tail -1 | awk -v node="$label" '{printf "      %s: %s free of %s (%s used) at %s\n", node, $4, $2, $5, $6}'
  done

  echo "== Containers"
  status || true

  echo "== Nodes"
  if [ "$(env_get BITCOIN_ENABLED)" != "0" ]; then
    if compose exec -T bitcoin bitcoin-cli -datadir=/data getblockchaininfo 2>/dev/null |
      jq -r '"      Bitcoin: blocks \(.blocks)/\(.headers)  progress \((.verificationprogress*100*100|round)/100)%  ibd \(.initialblockdownload)  pruned \(.pruned)"'; then :; else
      echo "      Bitcoin RPC unreachable (normal during startup; if it persists, check $stack_command logs bitcoin)"
    fi
  fi
  if [ "$(env_get MONERO_ENABLED)" = "1" ]; then
    if compose exec -T monero /usr/local/bin/monero-healthcheck >/dev/null 2>&1; then
      echo "      Monero RPC reachable"
    else
      echo "      Monero RPC unreachable (normal during startup; if it persists, check $stack_command logs monero)"
    fi
  fi
  for node in tari litecoin dogecoin bitcoincash zcash; do
    upper=$(printf '%s' "$node" | tr '[:lower:]' '[:upper:]')
    [ "$(env_get "${upper}_ENABLED")" = 1 ] || continue
    [ "$(env_get "${upper}_ACTIVE")" != 0 ] || continue
    node_id=$(container_id "$node")
    if [ -n "$node_id" ] && docker inspect "$node_id" --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' 2>/dev/null | grep -q '^running healthy$'; then
      echo "      $node RPC reachable"
    else
      echo "      $node unavailable (normal during startup; if it persists, check $stack_command logs $node)"
    fi
  done

  echo "== Tor"
  compose logs --no-color tor 2>&1 | grep "Bootstrapped" | tail -1 | sed 's/^/      /' || echo "      no bootstrap log yet"
  if [ "$(env_get DASHBOARD_ONION)" = "1" ]; then
    echo "      dashboard onion: $(compose exec -T tor cat /var/lib/tor/dashboard_onion/hostname 2>/dev/null || echo 'not provisioned yet')"
  fi
  if [ "$(env_get BITCOIN_ENABLED)" != "0" ] && [ "$(env_get BITCOIN_INBOUND_ONION)" = "1" ]; then
    echo "      node onion: $(compose exec -T bitcoin bitcoin-cli -datadir=/data getnetworkinfo 2>/dev/null | jq -r '.localaddresses[0].address // "not registered yet"')"
  fi
}

do_backup() {
  umask 077
  mkdir -p "$state_dir/backups"
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  [ -f "$config_file" ] && cp "$config_file" "$tmp/config.json"
  [ -f "$env_file" ] && cp "$env_file" "$tmp/.env"
  # bitcoind stores its inbound-onion key in the datadir
  data_dir=$(env_get BITCOIN_DATA_DIR)
  if [ -n "$data_dir" ] && [ -f "$data_dir/onion_v3_private_key" ]; then
    cp "$data_dir/onion_v3_private_key" "$tmp/" 2>/dev/null ||
      echo "WARN: node onion key not captured (unreadable — run backup as the node's user, uid 1000)"
  fi
  # the dashboard onion keys live in the tor volume
  compose cp tor:/var/lib/tor/dashboard_onion "$tmp/dashboard_onion" >/dev/null 2>&1 ||
    echo "WARN: dashboard onion keys not captured (is the tor container up?)"
  # UI-managed dashboard state is not otherwise re-derivable.
  compose cp dashboard:/state "$tmp/dashboard_state" >/dev/null 2>&1 ||
    echo "WARN: dashboard state not captured (is the dashboard container up?)"
  out="$state_dir/backups/stack-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
  tar czf "$out" -C "$tmp" .
  chmod 600 "$out"
  echo "Wrote $out (config, credentials, onion keys, dashboard state — chain data excluded, it's re-derivable)"
}

do_restore() {
  umask 077
  yes=0
  if [ "${1:-}" = "-y" ]; then
    yes=1
    shift
  fi
  if [ -z "${1:-}" ]; then
    echo "usage: ./stack restore [-y] <archive>"
    exit 1
  fi
  archive=$1
  if [ "$yes" != "1" ]; then
    printf "This overwrites config.json, .env, and onion keys from %s. Continue? [y/N] " "$archive"
    read -r reply
    case "$reply" in y | Y) ;; *)
      echo "Aborted."
      exit 1
      ;;
    esac
  fi
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  tar xzf "$archive" -C "$tmp"
  if [ -f "$tmp/config.json" ]; then
    replace_config "$tmp/config.json"
    echo "Restored config.json"
  fi
  if [ -f "$tmp/.env" ]; then
    chmod 600 "$env_file" 2>/dev/null || true
    cp "$tmp/.env" "$env_file" && chmod 600 "$env_file" && echo "Restored .env"
  fi
  data_dir=$(env_get BITCOIN_DATA_DIR)
  if [ -f "$tmp/onion_v3_private_key" ] && [ -n "$data_dir" ]; then
    cp "$tmp/onion_v3_private_key" "$data_dir/" && echo "Restored node onion key"
  fi
  if [ -d "$tmp/dashboard_onion" ]; then
    if compose cp "$tmp/dashboard_onion" tor:/var/lib/tor/ >/dev/null 2>&1 &&
      compose exec -u root tor chown -R tor:tor /var/lib/tor/dashboard_onion >/dev/null 2>&1; then
      compose restart tor >/dev/null
      echo "Restored dashboard onion keys (tor restarted)"
    else
      echo "WARN: could not restore dashboard onion keys (is the tor container up?)"
    fi
  fi
  if [ -d "$tmp/dashboard_state" ]; then
    # Extract as the dashboard user so private files keep the correct owner.
    if tar -cf - -C "$tmp/dashboard_state" . |
    compose exec -T -u 1000 dashboard tar -xof - -C /state; then
      echo "Restored dashboard state"
    else
      echo "ERROR: could not restore dashboard state (is the dashboard container up and writable by uid 1000?)"
      exit 1
    fi
  fi
  [ ! -f "$env_file" ] || approve_current_config
  echo "Done. Apply with: $stack_command apply"
}

do_upgrade() {
  cat <<EOF
Node Manager does not update itself. Install the new version with the method you originally used:

Back up first if you want a restore point:
  $stack_command backup

  Ubuntu / APT
    sudo apt update
    sudo apt install --only-upgrade bitcoin-starter-stack

  macOS / Homebrew
    brew update
    brew upgrade bitcoin-starter-stack
    $stack_command pull
    $stack_command apply

  GitHub release or source install
    https://github.com/VijitSingh97/node-manager/releases/latest
EOF
}

upgrade_agent() {
  echo "upgrade-agent is now host-service; application updates are manual."
  exec "$stack_root/stack" host-service
}

ensure_agent() {
  if [ "$package_managed" = brew ]; then
    command -v brew >/dev/null 2>&1 || {
      echo "Homebrew is required to start dashboard host controls." >&2
      return 1
    }
    brew services start bitcoin-starter-stack >/dev/null || {
      echo "Homebrew could not start dashboard host controls." >&2
      return 1
    }
    echo "Host controls and automatic post-sync caps are running through Homebrew."
    return 0
  fi
  [ "$package_managed" = "1" ] && return 0
  if [ "$(uname -s)" != Darwin ] && {
    systemctl is-enabled bitcoin-stack-host-service >/dev/null 2>&1 ||
      systemctl is-enabled bitcoin-stack-upgrade-agent >/dev/null 2>&1
  }; then
    return 0
  fi
  exec 9>"$state_dir/.host-service.lock"
  if flock -n 9; then
    flock -u 9
    host_log=$state_dir/host-service.log
    touch "$host_log"
    chmod 600 "$host_log"
    nohup env BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_dir" BITCOIN_STACK_CONFIG_DIR="$config_dir" \
      "$stack_root/stack" host-service >>"$host_log" 2>&1 </dev/null &
    echo $! >"$state_dir/.host-service.pid"
    echo "host-service: started for this login session (log: $host_log)"
  else
    echo "host-service: already running"
  fi
  [ "$(uname -s)" = Darwin ] && return 0
  printf -v quoted_root '%q' "$stack_root"
  printf -v quoted_state '%q' "$state_dir"
  line="@reboot sleep 60 && cd $quoted_root && ./stack host-service >> $quoted_state/host-service.log 2>&1"
  existing_cron=$(crontab -l 2>/dev/null || true)
  { printf '%s\n' "$existing_cron" |
      grep -vF "cd $stack_root && ./stack upgrade-agent" |
      grep -vF "cd $quoted_root && ./stack upgrade-agent" |
      grep -vF "cd $quoted_root && ./stack host-service" || true; echo "$line"; } | crontab - 2>/dev/null ||
    echo "WARN  could not install the host-service @reboot cron entry"
}

legacy_upgrade_agent_matches() {
  local process=$1 canonical_root=$2 process_cwd argument candidate candidate_dir index
  local -a arguments=()
  [ -r "$process/cmdline" ] || return 1
  process_cwd=$(readlink "$process/cwd" 2>/dev/null || true)
  [ -n "$process_cwd" ] && process_cwd=$(cd "$process_cwd" 2>/dev/null && pwd -P || true)
  [ "$process_cwd" = "$canonical_root" ] || return 1
  while IFS= read -r -d '' argument; do arguments+=("$argument"); done <"$process/cmdline"
  for ((index = 0; index + 1 < ${#arguments[@]}; index++)); do
    [ "${arguments[index + 1]}" = upgrade-agent ] || continue
    case "${arguments[index]}" in
      /*) candidate=${arguments[index]} ;;
      *) candidate=$process_cwd/${arguments[index]} ;;
    esac
    candidate_dir=$(cd "${candidate%/*}" 2>/dev/null && pwd -P) || continue
    [ "$candidate_dir/${candidate##*/}" = "$canonical_root/stack" ] && return 0
  done
  return 1
}

migrate_legacy_upgrade_agent() {
  [ "$package_managed" = "0" ] || return 0
  [ "$(uname -s)" = Linux ] || return 0
  local proc_root=${BITCOIN_STACK_PROC_ROOT:-/proc} canonical_root process pid attempt failed=0
  local -a legacy_pids=()
  canonical_root=$(cd "$stack_root" && pwd -P)
  for process in "$proc_root"/[0-9]*; do
    pid=${process##*/}
    [ "$pid" != "$$" ] || continue
    legacy_upgrade_agent_matches "$process" "$canonical_root" || continue
    if ! kill -TERM "$pid" 2>/dev/null; then
      if legacy_upgrade_agent_matches "$process" "$canonical_root"; then
        echo "WARN  could not stop legacy upgrade-agent process $pid for this installation." >&2
        failed=1
      fi
      continue
    fi
    legacy_pids+=("$pid")
  done
  for pid in "${legacy_pids[@]}"; do
    for ((attempt = 0; attempt < 20; attempt++)); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null && legacy_upgrade_agent_matches "$proc_root/$pid" "$canonical_root"; then
      kill -KILL "$pid" 2>/dev/null || true
      sleep 0.1
    fi
    if kill -0 "$pid" 2>/dev/null && legacy_upgrade_agent_matches "$proc_root/$pid" "$canonical_root"; then
      echo "WARN  could not stop legacy upgrade-agent process $pid for this installation." >&2
      failed=1
    fi
  done
  return "$failed"
}

host_service() {
  umask 077
  exec 7>"$state_dir/.host-service.lock"
  flock -n 7 || { echo "Another host service is already running." >&2; return 1; }
  trap 'exit 0' TERM INT
  local started=0 ticks=0 helper
  echo "host-service: waiting for saved configuration and Docker."
  while true; do
    if { [ -r "$config_file" ] || { [ -r "$approved_config_file" ] && [ -r "$approved_env_file" ]; }; } &&
      docker info >/dev/null 2>&1; then
      if [ "$started" = 0 ]; then
        lock_config
        prepare_config_for_start
        unlock_config
        if [ "$(env_get STACK_RESTART_POLICY)" != unless-stopped ]; then
          started=1
          echo "host-service: launch at login is off; supervising controls only."
        elif (lock_config; offline_up || exit 1; unlock_config); then
          started=1
          echo "host-service: supervising node controls and post-sync limits."
        fi
      fi
      if [ "$started" = 1 ]; then
        guard_package_containers || return 1
        for helper in node-control node-port-control; do
          BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_dir" BITCOIN_STACK_CONFIG_DIR="$config_dir" \
            "$stack_root/scripts/$helper" || echo "host-service: $helper check failed; will retry."
        done
        if [ "$ticks" = 0 ]; then
          BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_dir" \
            "$stack_root/scripts/node-resource-profile" || echo "host-service: resource check failed; will retry."
        fi
        ticks=$(((ticks + 1) % 6))
      fi
    fi
    sleep 10 7>&- &
    wait $! || true
  done
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

case "$cmd" in
  up)
    migrate_legacy_upgrade_agent
    lock_config
    prepare_config_for_start
    offline_up "$@"
    unlock_config
    ensure_resource_profile_timer
    ensure_port_control_timer
    ensure_node_control_timer
    ensure_agent
    ;;
  init) init ;;
  down) guard_package_containers && compose down "$@" ;;
  stop) guard_package_containers && compose stop "$@" ;;
  restart)
    lock_config
    prepare_config_for_start
    if [ "$config_was_applied" = 1 ]; then
      offline_up "$@"
    else
      guard_package_containers && compose restart "$@"
    fi
    unlock_config
    ;;
  logs) guard_package_containers && compose logs -f --tail=100 "$@" ;;
  events) guard_package_containers && compose exec -T dashboard sh -c 'cat /state/events.log 2>/dev/null || echo "no events yet"' ;;
  apply)
    migrate_legacy_upgrade_agent
    lock_config
    previous_env=$(mktemp "$state_dir/.env.before-apply.XXXXXX")
    previous_approved_config=$(mktemp "$state_dir/.approved-config.before-apply.XXXXXX")
    previous_approved_env=$(mktemp "$state_dir/.approved-env.before-apply.XXXXXX")
    had_previous_env=0
    had_previous_approved_config=0
    had_previous_approved_env=0
    if [ -f "$env_file" ]; then
      cp "$env_file" "$previous_env"
      had_previous_env=1
    fi
    if [ -f "$approved_config_file" ]; then cp "$approved_config_file" "$previous_approved_config"; had_previous_approved_config=1; fi
    if [ -f "$approved_env_file" ]; then cp "$approved_env_file" "$previous_approved_env"; had_previous_approved_env=1; fi
    apply_failed=0
    runtime_attempted=0
    if render_current_config; then
      runtime_attempted=1
      if ! offline_up || ! approve_current_config; then
        apply_failed=1
      fi
    else
      apply_failed=1
    fi
    if [ "$apply_failed" = 1 ]; then
      rollback_failed=0
      if [ "$had_previous_env" = 1 ]; then
        cp "$previous_env" "$env_file"
        if [ "$runtime_attempted" = 1 ]; then
          offline_up >/dev/null 2>&1 || rollback_failed=1
        fi
      else
        if [ "$runtime_attempted" = 1 ]; then
          compose down >/dev/null 2>&1 || rollback_failed=1
        fi
        rm -f "$env_file"
      fi
      if [ "$had_previous_approved_config" = 1 ]; then cp "$previous_approved_config" "$approved_config_file"; else rm -f "$approved_config_file"; fi
      if [ "$had_previous_approved_env" = 1 ]; then cp "$previous_approved_env" "$approved_env_file"; else rm -f "$approved_env_file"; fi
      rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
      unlock_config
      [ "$rollback_failed" = 0 ] || echo "New configuration failed, and the previous runtime could not be fully restored." >&2
      echo "New configuration was not approved; the previous runtime settings remain selected." >&2
      exit 1
    fi
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    unlock_config
    ensure_resource_profile_timer
    ensure_port_control_timer
    ensure_node_control_timer
    ensure_agent
    ;;
  approve-rendered-config)
    [ "${BITCOIN_STACK_CONFIG_LOCK_HELD:-0}" = 1 ] || {
      echo "approve-rendered-config requires the configuration lock." >&2
      exit 1
    }
    approve_current_config
    ;;
  apply-port-settings)
    lock_config
    "$stack_root/configure.sh"
    guard_package_containers
    compose up -d --pull never --no-build --no-deps tor dashboard || {
      echo "Port settings could not be applied with the installed images."
      exit 1
    }
    approve_current_config
    unlock_config
    ;;
  apply-credential-settings)
    node=${1:-}
    case "$node" in
      bitcoin) services=(bitcoin dashboard) ;;
      monero) services=(monero monero-wallet dashboard) ;;
      litecoin | dogecoin | bitcoincash) services=("$node" dashboard) ;;
      zcash) services=(dashboard) ;;
      *) echo "Unsupported credential target: $node" >&2; exit 1 ;;
    esac
    lock_config
    [ "$(jq -r --arg node "$node" 'if .[$node] | has("active") then .[$node].active == true else true end' "$config_file")" = true ] || {
      echo "Cannot apply credentials for an inactive node." >&2
      exit 1
    }
    credential_limits=${BITCOIN_STACK_CREDENTIAL_LIMITS:-}
    if [ "$node" != zcash ] && [ -z "$credential_limits" ]; then
      node_id=$(container_id "$node")
      [ -n "$node_id" ] || {
        echo "Current node container could not be found." >&2
        exit 1
      }
      credential_limits=$(docker inspect --format '{{.HostConfig.NanoCpus}} {{.HostConfig.Memory}} {{.HostConfig.MemorySwap}}' "$node_id")
    fi
    if [ "$node" != zcash ] && [[ ! "$credential_limits" =~ ^[0-9]+\ [0-9]+\ -?[0-9]+$ ]]; then
      echo "Current node resource limits could not be preserved." >&2
      exit 1
    fi
    "$stack_root/configure.sh"
    guard_package_containers
    compose up -d --pull never --no-build --no-deps "${services[@]}" || {
      echo "RPC credentials could not be applied with the installed images."
      exit 1
    }
    if [ "$node" != zcash ]; then
      read -r nano_cpus memory_bytes memory_swap <<<"$credential_limits"
      update_args=()
      [ "$nano_cpus" = 0 ] || update_args+=(--cpus "$(awk -v value="$nano_cpus" 'BEGIN { printf "%.9f", value / 1000000000 }')")
      if [ "$memory_bytes" != 0 ]; then
        update_args+=(--memory "$memory_bytes" --memory-swap "$memory_swap")
      elif [ "$memory_swap" != 0 ]; then
        echo "Current node resource limits are inconsistent." >&2
        exit 1
      fi
      [ "${#update_args[@]}" = 0 ] || docker update "${update_args[@]}" "$node_id" >/dev/null || {
        echo "Current node resource limits could not be restored." >&2
        exit 1
      }
    fi
    credential_wait=${BITCOIN_STACK_CREDENTIAL_WAIT_SECONDS:-300}
    [[ "$credential_wait" =~ ^[0-9]+$ ]] && [ "$credential_wait" -ge 1 ] && [ "$credential_wait" -le 3600 ] || {
      echo "Invalid credential readiness timeout." >&2
      exit 1
    }
    credential_deadline=$((SECONDS + credential_wait))
    while true; do
      credential_ready=1
      for service in "${services[@]}"; do
        service_id=$(container_id "$service")
        [ -n "$service_id" ] && [ "$(docker inspect --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' "$service_id" 2>/dev/null || true)" = "running healthy" ] || credential_ready=0
      done
      [ "$credential_ready" = 0 ] || break
      [ "$SECONDS" -lt "$credential_deadline" ] || {
        echo "Credential services did not become ready." >&2
        exit 1
      }
      sleep 2
    done
    approve_current_config
    unlock_config
    ;;
  upgrade) do_upgrade ;;
  package-upgrade) package_upgrade ;;
  pull)
    lock_config
    "$stack_root/configure.sh"
    pull_images "$@"
    unlock_config
    ;;
  upgrade-agent) upgrade_agent ;;
  host-service) host_service ;;
  status) status ;;
  doctor) doctor ;;
  backup) guard_package_containers && do_backup ;;
  restore) guard_package_containers && do_restore "$@" ;;
  help | --help | -h) usage ;;
  *)
    echo "Unknown command: $cmd"
    usage
    exit 1
    ;;
esac
