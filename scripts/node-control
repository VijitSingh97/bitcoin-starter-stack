#!/bin/sh
set -eu
stack_root=${BITCOIN_STACK_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}
state_root=${BITCOIN_STACK_STATE_DIR:-$stack_root}
config_root=${BITCOIN_STACK_CONFIG_DIR:-$state_root}
env_file=$state_root/.env
config_file=$config_root/config.json
approved_config=$state_root/.approved-config.json
docker_bin=${DOCKER_BIN:-docker}
now=${NODE_CONTROL_NOW_EPOCH:-$(date +%s)}
package_managed=${BITCOIN_STACK_PACKAGE_MANAGED:-0}
host_os=${NODE_CONTROL_OS:-$(uname -s)}
project_name=${BITCOIN_STACK_PROJECT_NAME:-$(sed -n 's/^COMPOSE_PROJECT_NAME=//p' "$env_file" 2>/dev/null | tail -n 1)}
if [ -z "$project_name" ]; then
  case "$package_managed" in brew) project_name=bitcoin-starter-stack-brew ;; 1 | apt) project_name=bitcoin-starter-stack-apt ;; *) project_name=bitcoin-starter-stack ;; esac
fi
container_id() {
  "$docker_bin" ps -aq \
    --filter "label=com.docker.compose.project=$project_name" \
    --filter "label=com.docker.compose.service=$1" | head -n 1
}
dashboard_id=$(container_id dashboard)
mkdir -p "$state_root/node-control"
chmod 700 "$state_root/node-control"
exec 9>"$state_root/node-control/.lock"
flock -n 9 || exit 0
dashboard_exec() { [ -n "$dashboard_id" ] && "$docker_bin" exec -u 1000 "$dashboard_id" "$@"; }
write_status() {
  jq -nc --arg id "$1" --arg node "$2" --argjson active "$3" --arg state "$4" --arg message "$5" --arg error_code "${6:-}" \
    '{id:$id,node:$node,active:$active,state:$state,message:$message} | if $error_code=="" then . else .error_code=$error_code end' |
    $docker_bin exec -i -u 1000 "$dashboard_id" sh -c 'umask 077; cat > /state/.node-control.status.tmp; mv /state/.node-control.status.tmp /state/node-control.status' >/dev/null
}
clear_request() { dashboard_exec rm -f /state/node-control.processing >/dev/null 2>&1 || true; }
write_host_status() {
  jq -nc --arg id "$1" --arg action "$2" --arg state "$3" --arg message "$4" \
    --arg node "${5:-}" --arg enabled "${6:-}" --arg error_code "${7:-}" --arg port "${8:-}" '
    {id:$id,action:$action,state:$state,message:$message} |
    if $node=="" then . else .node=$node end |
    if $enabled=="" then . else .enabled=($enabled=="true") end |
    if $error_code=="" then . else .error_code=$error_code end |
    if $port=="" then . else .port=$port end' |
    $docker_bin exec -i -u 1000 "$dashboard_id" sh -c 'umask 077; cat > /state/.node-control.status.tmp; mv /state/.node-control.status.tmp /state/node-control.status' >/dev/null
}
canonical_config() {
  source=$1
  if [ -f "$source" ]; then jq -S -c . "$source" 2>/dev/null; else printf '{}\n'; fi
}
config_revision() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'; else shasum -a 256 | awk '{print $1}'; fi
}
approve_config() {
  BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
    BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/stack" approve-rendered-config >/dev/null 2>&1
}
install_transaction=$state_root/node-control/install-transaction
install_recovery_status=$state_root/node-control/install-recovery.status
restore_transaction_file() {
  source=$1
  destination=$2
  present=$3
  if [ "$present" = true ]; then
    restore_tmp=$(mktemp "$(dirname "$destination")/.install-restore.XXXXXX")
    cp "$source" "$restore_tmp"
    chmod 600 "$restore_tmp"
    mv "$restore_tmp" "$destination"
  else
    rm -f "$destination"
  fi
}
restore_install_transaction() {
  [ -d "$install_transaction" ] || return 0
  transaction_meta=$install_transaction/meta.json
  jq -e '
    type=="object" and (.id|type=="string") and
    (.node=="bitcoin" or .node=="monero" or .node=="tari" or .node=="litecoin" or .node=="dogecoin" or .node=="bitcoincash" or .node=="zcash") and
    (.phase=="applying" or .phase=="applied") and
    (.had_config|type=="boolean") and (.had_env|type=="boolean") and
    (.had_approved_config|type=="boolean") and (.had_approved_env|type=="boolean")
  ' "$transaction_meta" >/dev/null 2>&1 || return 1
  transaction_phase=$(jq -r .phase "$transaction_meta")
  transaction_id=$(jq -r .id "$transaction_meta")
  transaction_node=$(jq -r .node "$transaction_meta")
  if [ "$transaction_phase" = applied ]; then
    BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
      BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/stack" up >/dev/null 2>&1 || return 1
    return 2
  fi
  restore_transaction_file "$install_transaction/config.before" "$config_file" "$(jq -r .had_config "$transaction_meta")" || return 1
  restore_transaction_file "$install_transaction/env.before" "$env_file" "$(jq -r .had_env "$transaction_meta")" || return 1
  restore_transaction_file "$install_transaction/approved-config.before" "$approved_config" "$(jq -r .had_approved_config "$transaction_meta")" || return 1
  restore_transaction_file "$install_transaction/approved-env.before" "$state_root/.approved.env" "$(jq -r .had_approved_env "$transaction_meta")" || return 1
  if [ "$transaction_node" = monero ]; then
    "$stack_root/stack" stop monero-wallet monero >/dev/null 2>&1 || true
  elif [ "$transaction_node" = tari ]; then
    "$stack_root/stack" stop tari-wallet tari >/dev/null 2>&1 || true
  else
    "$stack_root/stack" stop "$transaction_node" >/dev/null 2>&1 || true
  fi
  BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
    BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/stack" up >/dev/null 2>&1 || return 1
  rm -rf "$install_transaction"
}
if [ -d "$install_transaction" ]; then
  exec 8>"$state_root/.config.lock"
  flock 8
  recovery_result=0
  restore_install_transaction || recovery_result=$?
  if [ "$recovery_result" = 2 ]; then
    rm -f "$install_recovery_status"
    install_recovery_applied=true
  elif [ "$recovery_result" != 0 ]; then
    recovery_id=$(jq -r '.id // ""' "$install_transaction/meta.json" 2>/dev/null || true)
    recovery_node=$(jq -r '.node // ""' "$install_transaction/meta.json" 2>/dev/null || true)
    recovery_status_tmp=$(mktemp "$state_root/node-control/.recovery-status.XXXXXX")
    jq -nc --arg id "$recovery_id" --arg node "$recovery_node" \
      '{id:$id,action:"install",state:"failed",message:"Interrupted installation could not be restored.",node:$node,error_code:"rollback_failed"}' >"$recovery_status_tmp"
    chmod 600 "$recovery_status_tmp"
    mv "$recovery_status_tmp" "$install_recovery_status"
    install_recovery_failed=true
  else
    rm -f "$install_recovery_status"
  fi
fi
[ "${install_recovery_failed:-false}" = true ] || [ -r "$env_file" ] || exit 0
[ -n "$dashboard_id" ] || exit 0
config_files=$($docker_bin inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files" }}' "$dashboard_id" 2>/dev/null || true)
case ",$config_files," in *",$stack_root/docker-compose.yml,"*) ;; *) exit 0 ;; esac
if [ -f "$install_recovery_status" ]; then
  $docker_bin exec -i -u 1000 "$dashboard_id" sh -c 'umask 077; cat > /state/.node-control.status.tmp; mv /state/.node-control.status.tmp /state/node-control.status' <"$install_recovery_status" >/dev/null
  rm -f "$install_recovery_status"
  [ "${install_recovery_failed:-false}" != true ] || exit 0
fi
if [ "${install_recovery_applied:-false}" = true ]; then
  transaction_id=$(jq -r .id "$install_transaction/meta.json")
  transaction_node=$(jq -r .node "$install_transaction/meta.json")
  write_host_status "$transaction_id" install applied "Node installed." "$transaction_node"
  printf '%s\n' "$transaction_id" >>"$state_root/node-control/seen"
  transaction_seen=$(mktemp "$state_root/node-control/.seen.XXXXXX")
  tail -n 256 "$state_root/node-control/seen" >"$transaction_seen"
  chmod 600 "$transaction_seen"
  mv "$transaction_seen" "$state_root/node-control/seen"
  clear_request
  rm -rf "$install_transaction"
  exit 0
fi
restore_approved_runtime() {
  [ -f "$approved_config" ] && [ -f "$state_root/.approved.env" ] || return 1
  pending_copy=$(mktemp "$state_root/node-control/.pending-config.XXXXXX")
  pending_had_config=0
  if [ -f "$config_file" ]; then
    cp "$config_file" "$pending_copy"
    pending_had_config=1
  fi
  restore_config=$(mktemp "$config_root/.config.restore.XXXXXX")
  restore_env=$(mktemp "$state_root/.env.restore.XXXXXX")
  cp "$approved_config" "$restore_config"
  cp "$state_root/.approved.env" "$restore_env"
  chmod 600 "$restore_config" "$restore_env" "$pending_copy"
  mv "$restore_config" "$config_file"
  mv "$restore_env" "$env_file"
  restored=0
  BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
    BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/stack" up >/dev/null 2>&1 && restored=1
  if [ "$pending_had_config" = 1 ]; then
    mv "$pending_copy" "$config_file"
  else
    rm -f "$config_file" "$pending_copy"
  fi
  [ "$restored" = 1 ]
}
config_pending() {
  current=$(canonical_config "$config_file") || return 0
  approved=$(canonical_config "$approved_config") || return 0
  [ -f "$approved_config" ] && [ "$current" = "$approved" ] && return 1
  return 0
}
env_get() {
  sed -n "s/^$1=//p" "$env_file" | tail -n 1
}
host_absolute_path() {
  case "$1" in
    /*) printf '%s\n' "$1" ;;
    ./*) printf '%s/%s\n' "$stack_root" "${1#./}" ;;
    *) printf '%s/%s\n' "$stack_root" "$1" ;;
  esac
}
prepare_install_data_dir() {
  prepare_node=$1
  prepare_directory=$2
  [ -n "$prepare_directory" ] || return 0
  prepare_walk=
  prepare_rest=${prepare_directory#/}
  while [ -n "$prepare_rest" ]; do
    prepare_part=${prepare_rest%%/*}
    prepare_walk=$prepare_walk/$prepare_part
    [ ! -L "$prepare_walk" ] || return 1
    [ "$prepare_rest" != "$prepare_part" ] || break
    prepare_rest=${prepare_rest#*/}
  done
  if [ -e "$prepare_directory" ] && [ ! -d "$prepare_directory" ]; then return 1; fi
  mkdir -p -- "$prepare_directory" || return 1
  prepare_canonical=$(cd "$prepare_directory" 2>/dev/null && pwd -P) || return 1
  prepare_expected_variable=$(printf '%s_DATA_DIR' "$(printf '%s' "$prepare_node" | tr '[:lower:]' '[:upper:]')")
  prepare_expected=$(env_get "$prepare_expected_variable")
  [ -n "$prepare_expected" ] || prepare_expected=./data/$prepare_node
  prepare_expected=$(host_absolute_path "$prepare_expected")
  if [ -d "$prepare_expected" ]; then
    prepare_expected=$(cd "$prepare_expected" 2>/dev/null && pwd -P) || return 1
  fi
  prepare_stack=$(cd "$stack_root" 2>/dev/null && pwd -P) || return 1
  prepare_state=$(cd "$state_root" 2>/dev/null && pwd -P) || return 1
  prepare_config=$(cd "$config_root" 2>/dev/null && pwd -P) || return 1
  if [ "$prepare_canonical" != "$prepare_expected" ]; then
    for prepare_root in "$prepare_stack" "$prepare_state" "$prepare_config"; do
      [ "$prepare_canonical" != "$prepare_root" ] || return 1
      case "$prepare_canonical/" in "$prepare_root/"*) return 1 ;; esac
      case "$prepare_root/" in "$prepare_canonical/"*) return 1 ;; esac
    done
  fi
  if [ -n "${HOME:-}" ] && [ -d "$HOME" ]; then
    prepare_home=$(cd "$HOME" 2>/dev/null && pwd -P) || return 1
    [ "$prepare_canonical" != "$prepare_home" ] || return 1
    case "$prepare_home/" in "$prepare_canonical/"*) return 1 ;; esac
  fi
  prepare_contents=$(find "$prepare_canonical" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null) || return 1
  [ -z "$prepare_contents" ] || return 1
  if [ "$host_os" = Linux ]; then
    prepare_owner=1000:1000
    prepare_mode=700
    if [ "$prepare_node" = zcash ]; then
      prepare_owner=10001:1000
      prepare_mode=750
    fi
    prepare_actual_owner=$(stat -c '%u:%g' "$prepare_canonical" 2>/dev/null) || return 1
    prepare_actual_mode=$(stat -c '%a' "$prepare_canonical" 2>/dev/null) || return 1
    if [ "$prepare_actual_owner" != "$prepare_owner" ] || [ "$prepare_actual_mode" != "$prepare_mode" ]; then
      chown "$prepare_owner" "$prepare_canonical" || return 1
      chmod "$prepare_mode" "$prepare_canonical" || return 1
    fi
  else
    [ -w "$prepare_canonical" ] && [ -x "$prepare_canonical" ] || return 1
    chmod 700 "$prepare_canonical" || return 1
  fi
  printf '%s\n' "$prepare_canonical"
}
host_platform=source
boot_kind=unsupported
boot_supported=false
case "$package_managed:$host_os" in
  1:Linux) host_platform=linux; boot_kind=boot; boot_supported=true ;;
  brew:Darwin) host_platform=mac; boot_kind=login; boot_supported=true ;;
  brew:Linux) host_platform=linux; boot_kind=login; boot_supported=true ;;
esac
publish_host_capability() {
  boot_enabled=false
  restart_policy=$(sed -n 's/^STACK_RESTART_POLICY=//p' "$env_file" 2>/dev/null || true)
  if [ "$restart_policy" = unless-stopped ]; then
    boot_enabled=true
  elif [ "$restart_policy" != no ] && [ -f "$approved_config" ] &&
    [ "$(jq -r '.dashboard.launch_at_boot == true' "$approved_config" 2>/dev/null || true)" = true ]; then
    boot_enabled=true
  fi
  pending=false
  revision=
  if config_pending; then
    pending=true
    revision=$(canonical_config "$config_file" | config_revision)
  fi
  config_path=$(cd "$config_root" && pwd -P)/config.json
  data_paths='{}'
  for node_spec in bitcoin:BITCOIN_DATA_DIR monero:MONERO_DATA_DIR tari:TARI_DATA_DIR litecoin:LITECOIN_DATA_DIR dogecoin:DOGECOIN_DATA_DIR bitcoincash:BITCOINCASH_DATA_DIR zcash:ZCASH_DATA_DIR; do
    node=${node_spec%%:*}
    variable=${node_spec#*:}
    path=$(env_get "$variable")
    [ -n "$path" ] || path=./data/$node
    path=$(host_absolute_path "$path")
    data_paths=$(printf '%s' "$data_paths" | jq -c --arg node "$node" --arg path "$path" '.[$node]=$path')
  done
  jq -nc --argjson timestamp "$now" --arg platform "$host_platform" --arg boot_kind "$boot_kind" \
    --argjson boot_supported "$boot_supported" --argjson boot_enabled "$boot_enabled" --argjson config_pending "$pending" \
    --arg config_revision "$revision" --arg config_path "$config_path" --argjson data_paths "$data_paths" \
    '{timestamp:$timestamp,install_supported:true,boot_supported:$boot_supported,boot_enabled:$boot_enabled,config_pending:$config_pending,config_revision:$config_revision,platform:$platform,boot_kind:$boot_kind,config_path:$config_path,data_paths:$data_paths}' |
    $docker_bin exec -i -u 1000 "$dashboard_id" sh -c 'umask 077; cat > /state/.node-control.capability.tmp; mv /state/.node-control.capability.tmp /state/node-control.capability' >/dev/null
}
publish_host_capability
if ! dashboard_exec test -f /state/node-control.processing >/dev/null 2>&1; then
  dashboard_exec test -f /state/node-control.request >/dev/null 2>&1 || exit 0
  dashboard_exec mv /state/node-control.request /state/node-control.processing >/dev/null 2>&1 || exit 0
fi
size=$(dashboard_exec sh -c 'wc -c < /state/node-control.processing' 2>/dev/null | tr -d ' ' || true)
case "$size" in '' | *[!0-9]*) size=4097 ;; esac
if [ "$size" -gt 4096 ]; then
  write_status "" "" false rejected "Invalid request." invalid_request
  clear_request
  exit 0
fi
request=$(dashboard_exec cat /state/node-control.processing 2>/dev/null || true)
host_seen_file=$state_root/node-control/seen
host_remember_seen() {
  printf '%s\n' "$host_id" >>"$host_seen_file"
  host_seen_tmp=$(mktemp "$state_root/node-control/.seen.XXXXXX")
  tail -n 256 "$host_seen_file" >"$host_seen_tmp"
  chmod 600 "$host_seen_tmp"
  mv "$host_seen_tmp" "$host_seen_file"
}
host_finish() {
  publish_host_capability
  write_host_status "$host_id" "$host_action" "$1" "$2" "${3:-}" "${4:-}" "${5:-}" "${6:-}"
  host_remember_seen
  clear_request
  [ -z "${host_cleanup_transaction:-}" ] || rm -rf "$host_cleanup_transaction"
  exit 0
}
host_request=false
if printf '%s' "$request" | jq -e --argjson now "$now" '
  def node_interface($node):
    if $node=="bitcoin" then "bitcoin_rpc"
    elif $node=="monero" then "monero_rpc|monero_zmq"
    elif $node=="tari" then "tari_grpc"
    elif $node=="litecoin" then "litecoin_rpc"
    elif $node=="dogecoin" then "dogecoin_rpc"
    elif $node=="bitcoincash" then "bitcoincash_rpc"
    else "zcash_rpc" end;
  . as $request |
  type=="object" and
  (keys==["action","id","node","requested_at"] or
   (keys==["action","data_dir","id","interfaces","node","requested_at"] and
    (.data_dir|type=="string" and length>1 and length<=1024 and startswith("/") and
      (explode|all(. != 0 and . != 10 and . != 13)) and
      (contains("//")|not) and (split("/")|all(. != "." and . != ".."))) and
    (.interfaces|type=="array" and length<=2 and
      (([.[].id]|length)==([.[].id]|unique|length)) and
      all(.[]; type=="object" and keys==["enabled","host_port","id"] and
        (.id|type=="string" and test("^(" + node_interface($request.node) + ")$")) and
        (.enabled|type=="boolean") and
        (.host_port|type=="number" and floor==. and .>=1 and .<=65535))))) and
  .action=="install" and
  (.id|type=="string" and test("^[0-9a-f]{32}$")) and
  (.node=="bitcoin" or .node=="monero" or .node=="tari" or .node=="litecoin" or .node=="dogecoin" or .node=="bitcoincash" or .node=="zcash") and
  (.requested_at|type=="number" and floor==. and . >= $now-300 and . <= $now+30)
' >/dev/null 2>&1; then
  host_request=true
elif printf '%s' "$request" | jq -e --argjson now "$now" '
  type=="object" and keys==["action","enabled","id","requested_at"] and .action=="launch_at_boot" and
  (.id|type=="string" and test("^[0-9a-f]{32}$")) and (.enabled|type=="boolean") and
  (.requested_at|type=="number" and floor==. and . >= $now-300 and . <= $now+30)
' >/dev/null 2>&1; then
  host_request=true
elif printf '%s' "$request" | jq -e --argjson now "$now" '
  type=="object" and keys==["action","config_revision","id","requested_at"] and .action=="apply_config" and
  (.id|type=="string" and test("^[0-9a-f]{32}$")) and
  (.config_revision|type=="string" and test("^[0-9a-f]{64}$")) and
  (.requested_at|type=="number" and floor==. and . >= $now-300 and . <= $now+30)
' >/dev/null 2>&1; then
  host_request=true
fi
if [ "$host_request" = true ]; then
  host_id=$(printf '%s' "$request" | jq -r .id)
  host_action=$(printf '%s' "$request" | jq -r .action)
  if [ -r "$host_seen_file" ] && grep -Fxq "$host_id" "$host_seen_file"; then
    host_finish rejected "Request already processed." "$(printf '%s' "$request" | jq -r '.node // empty')" "$(printf '%s' "$request" | jq -r '.enabled // empty')" replayed
  fi
  mkdir -p "$config_root"
  exec 8>"$state_root/.config.lock"
  flock 8
  if [ "$host_action" != apply_config ] && config_pending; then
    host_finish rejected "Review the pending config change first." "$(printf '%s' "$request" | jq -r '.node // empty')" "$(printf '%s' "$request" | jq -r '.enabled // empty')" config_pending
  fi
  if [ "$host_action" = apply_config ]; then
    requested_revision=$(printf '%s' "$request" | jq -r .config_revision)
    current_revision=$(canonical_config "$config_file" | config_revision)
    if ! config_pending || [ "$requested_revision" != "$current_revision" ]; then
      host_finish rejected "The pending config changed; review it again." "" "" config_changed
    fi
    if ! BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
      BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/stack" apply >/dev/null 2>&1; then
      restore_approved_runtime || host_finish failed "Config apply failed and the prior runtime could not be fully restored." "" "" rollback_failed
      host_finish failed "Config could not be applied." "" "" apply_failed
    fi
    approved_revision=$(canonical_config "$approved_config" | config_revision)
    [ "$approved_revision" = "$requested_revision" ] || host_finish failed "Config approval could not be verified." "" "" approval_failed
    host_finish applied "Config applied."
  fi
  if [ "$host_action" = install ]; then
    host_node=$(printf '%s' "$request" | jq -r .node)
    host_data_dir=$(printf '%s' "$request" | jq -r '.data_dir // ""')
    host_interfaces=$(printf '%s' "$request" | jq -c '.interfaces // []')
    host_bind_ip=$(env_get DASHBOARD_BIND_IP)
    current='{}'
    [ -f "$config_file" ] && current=$(cat "$config_file")
    configured=$(printf '%s' "$current" | jq -r --arg node "$host_node" 'if $node=="bitcoin" then ((.bitcoin//{}|has("enabled")|not) or .bitcoin.enabled==true) else .[$node].enabled==true end')
    [ "$configured" != true ] || host_finish rejected "Node is already installed." "$host_node" "" already_installed
    memory=4096
    [ "$host_node" != bitcoin ] && [ "$host_node" != monero ] || memory=2048
    candidate=$(mktemp "$config_root/.config.install.XXXXXX")
    printf '%s' "$current" | jq --arg node "$host_node" --arg data_dir "$host_data_dir" --arg bind_ip "$host_bind_ip" --argjson interfaces "$host_interfaces" --argjson memory "$memory" '
      .[$node].enabled=true | .[$node].active=true |
      .[$node].resource_profile //= "compact" |
      .[$node].steady_cpus //= 1 | .[$node].steady_mem_limit_mb //= $memory |
      if $data_dir!="" then .[$node].data_dir=$data_dir else . end |
      if $node=="monero" then .[$node].rpc_expose=false | .[$node].zmq_expose=false
      elif $node=="tari" then .[$node].grpc_expose=false
      else .[$node].rpc_expose=false end |
      reduce $interfaces[] as $interface (.;
        if $interface.id=="bitcoin_rpc" then .bitcoin.rpc_expose=$interface.enabled | if $interface.enabled then .bitcoin.rpc_bind_ip=$bind_ip | .bitcoin.rpc_port=$interface.host_port else . end
        elif $interface.id=="monero_rpc" then .monero.rpc_expose=$interface.enabled | if $interface.enabled then .monero.rpc_bind_ip=$bind_ip | .monero.rpc_port=$interface.host_port else . end
        elif $interface.id=="monero_zmq" then .monero.zmq_expose=$interface.enabled | if $interface.enabled then .monero.zmq_bind_ip=$bind_ip | .monero.zmq_port=$interface.host_port else . end
        elif $interface.id=="tari_grpc" then .tari.grpc_expose=$interface.enabled | if $interface.enabled then .tari.grpc_bind_ip=$bind_ip | .tari.grpc_port=$interface.host_port else . end
        elif $interface.id=="litecoin_rpc" then .litecoin.rpc_expose=$interface.enabled | if $interface.enabled then .litecoin.rpc_bind_ip=$bind_ip | .litecoin.rpc_port=$interface.host_port else . end
        elif $interface.id=="dogecoin_rpc" then .dogecoin.rpc_expose=$interface.enabled | if $interface.enabled then .dogecoin.rpc_bind_ip=$bind_ip | .dogecoin.rpc_port=$interface.host_port else . end
        elif $interface.id=="bitcoincash_rpc" then .bitcoincash.rpc_expose=$interface.enabled | if $interface.enabled then .bitcoincash.rpc_bind_ip=$bind_ip | .bitcoincash.rpc_port=$interface.host_port else . end
        else .zcash.rpc_expose=$interface.enabled | if $interface.enabled then .zcash.rpc_bind_ip=$bind_ip | .zcash.rpc_port=$interface.host_port else . end
        end)' >"$candidate"
    validate=$(mktemp -d "$state_root/node-control/.validate.XXXXXX")
    cp "$candidate" "$validate/config.json"
    if ! BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$validate" \
      BITCOIN_STACK_VALIDATE_ONLY=1 BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/configure.sh" >/dev/null 2>&1; then
      rm -rf "$candidate" "$validate"
      host_finish rejected "Node defaults are invalid." "$host_node" "" validation_failed
    fi
    rm -rf "$validate"
    host_port_changes=$(printf '%s' "$host_interfaces" | jq -c --arg bind_ip "$host_bind_ip" '[.[]|select(.enabled)|{port:.id,enabled:true,bind_ip:$bind_ip,host_port:.host_port}]')
    if [ "$(printf '%s' "$host_port_changes" | jq 'length')" -gt 0 ]; then
      if ! host_port_check=$(BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
        "$stack_root/scripts/node-port-control" --check-ports "$host_port_changes"); then
        case "$host_port_check" in
          port_in_use:*) host_finish rejected "Selected port is already in use." "$host_node" "" port_in_use "${host_port_check#*:}" ;;
          bind_address_unavailable:*) host_finish rejected "Selected LAN address is not assigned to this host." "$host_node" "" validation_failed ;;
          *) host_finish failed "Port availability could not be checked." "$host_node" "" validation_failed ;;
        esac
      fi
    fi
    if ! prepared_data_dir=$(prepare_install_data_dir "$host_node" "$host_data_dir"); then
      rm -f "$candidate"
      host_finish rejected "Data folder must be a new or empty writable folder outside app and config roots, without symbolic links." "$host_node" "" data_path_invalid
    fi
    if [ -n "$prepared_data_dir" ] && [ "$prepared_data_dir" != "$host_data_dir" ]; then
      candidate_tmp=$(mktemp "$config_root/.config.install-path.XXXXXX")
      jq --arg node "$host_node" --arg data_dir "$prepared_data_dir" '.[$node].data_dir=$data_dir' "$candidate" >"$candidate_tmp"
      chmod 600 "$candidate_tmp"
      mv "$candidate_tmp" "$candidate"
      host_data_dir=$prepared_data_dir
    fi
    transaction_tmp=$(mktemp -d "$state_root/node-control/.install-transaction.XXXXXX")
    had_config=false
    had_env=false
    had_approved_config=false
    had_approved_env=false
    if [ -f "$config_file" ]; then cp "$config_file" "$transaction_tmp/config.before"; had_config=true; fi
    if [ -f "$env_file" ]; then cp "$env_file" "$transaction_tmp/env.before"; had_env=true; fi
    if [ -f "$approved_config" ]; then cp "$approved_config" "$transaction_tmp/approved-config.before"; had_approved_config=true; fi
    if [ -f "$state_root/.approved.env" ]; then cp "$state_root/.approved.env" "$transaction_tmp/approved-env.before"; had_approved_env=true; fi
    jq -nc --arg id "$host_id" --arg node "$host_node" --arg phase applying \
      --argjson had_config "$had_config" --argjson had_env "$had_env" \
      --argjson had_approved_config "$had_approved_config" --argjson had_approved_env "$had_approved_env" \
      '{id:$id,node:$node,phase:$phase,had_config:$had_config,had_env:$had_env,had_approved_config:$had_approved_config,had_approved_env:$had_approved_env}' >"$transaction_tmp/meta.json"
    chmod 600 "$candidate" "$transaction_tmp"/*
    mv "$transaction_tmp" "$install_transaction"
    mv "$candidate" "$config_file"
    if BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
      BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/stack" pull --policy missing >/dev/null 2>&1 &&
      BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
      BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/stack" apply >/dev/null 2>&1; then
      transaction_meta_tmp=$(mktemp "$install_transaction/.meta.XXXXXX")
      jq '.phase="applied"' "$install_transaction/meta.json" >"$transaction_meta_tmp"
      chmod 600 "$transaction_meta_tmp"
      mv "$transaction_meta_tmp" "$install_transaction/meta.json"
      host_cleanup_transaction=$install_transaction
      host_finish applied "Node installed." "$host_node"
    fi
    restore_install_transaction ||
      host_finish failed "Node installation failed and prior configuration could not be fully restored." "$host_node" "" rollback_failed
    host_finish failed "Node installation failed; prior configuration restored." "$host_node" "" apply_failed
  fi
  if [ "$host_action" = launch_at_boot ]; then
    [ "$boot_supported" = true ] || host_finish rejected "Launch at boot is not managed for source installs." "" "$(printf '%s' "$request" | jq -r .enabled)" unsupported
    host_enabled=$(printf '%s' "$request" | jq -r .enabled)
    current='{}'
    [ -f "$config_file" ] && current=$(cat "$config_file")
    old_enabled=false
    [ "$(printf '%s' "$current" | jq -r '.dashboard.launch_at_boot == true')" != true ] || old_enabled=true
    [ "$old_enabled" != "$host_enabled" ] || host_finish rejected "Launch setting is already in that state." "" "$host_enabled" unchanged
    candidate=$(mktemp "$config_root/.config.boot.XXXXXX")
    printf '%s' "$current" | jq --argjson enabled "$host_enabled" '.dashboard.launch_at_boot=$enabled' >"$candidate"
    validate=$(mktemp -d "$state_root/node-control/.validate.XXXXXX")
    cp "$candidate" "$validate/config.json"
    if ! BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$validate" \
      BITCOIN_STACK_VALIDATE_ONLY=1 BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/configure.sh" >/dev/null 2>&1; then
      rm -rf "$candidate" "$validate"
      host_finish rejected "Launch setting is invalid." "" "$host_enabled" validation_failed
    fi
    rm -rf "$validate"
    policies=$(mktemp "$state_root/node-control/.restart-policies.XXXXXX")
    for service in tor bitcoin monero monero-wallet tari tari-wallet litecoin dogecoin bitcoincash zcash dashboard; do
      service_id=$(container_id "$service")
      [ -n "$service_id" ] || continue
      details=$($docker_bin inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files" }}|{{.HostConfig.RestartPolicy.Name}}|{{.HostConfig.RestartPolicy.MaximumRetryCount}}' "$service_id" 2>/dev/null || true)
      [ -n "$details" ] || continue
      case "${details%%|*}" in *"$stack_root/docker-compose.yml"*) ;; *) rm -f "$candidate" "$policies"; host_finish rejected "A running container belongs to another installation." "" "$host_enabled" ownership_conflict ;; esac
      policy_details=${details#*|}
      printf '%s|%s|%s|%s\n' "$service" "$service_id" "${policy_details%%|*}" "${policy_details#*|}" >>"$policies"
    done
    backup=$(mktemp "$state_root/node-control/.config.backup.XXXXXX")
    printf '%s' "$current" >"$backup"
    chmod 600 "$candidate" "$backup" "$policies"
    mv "$candidate" "$config_file"
    policy=on-failure:5
    [ "$host_enabled" != true ] || policy=unless-stopped
    boot_failed=false
    while IFS='|' read -r service service_id old_policy old_retries; do
      [ -n "$service" ] || continue
      $docker_bin update --restart="$policy" "$service_id" >/dev/null 2>&1 || { boot_failed=true; break; }
    done <"$policies"
    if [ "$boot_failed" = false ] && BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
      BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/configure.sh" >/dev/null 2>&1; then
      if approve_config; then
        rm -f "$backup" "$policies"
        host_finish applied "Launch setting saved." "" "$host_enabled"
      fi
    fi
    launch_rollback_failed=false
    mv "$backup" "$config_file" || launch_rollback_failed=true
    BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
      BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/configure.sh" >/dev/null 2>&1 || launch_rollback_failed=true
    while IFS='|' read -r service service_id old_policy old_retries; do
      [ -n "$service" ] || continue
      restore_policy=${old_policy:-no}
      if [ "$restore_policy" = on-failure ] && [ "${old_retries:-0}" -gt 0 ]; then
        restore_policy=on-failure:$old_retries
      fi
      $docker_bin update --restart="$restore_policy" "$service_id" >/dev/null 2>&1 || launch_rollback_failed=true
    done <"$policies"
    rm -f "$policies"
    [ "$launch_rollback_failed" != true ] ||
      host_finish failed "Launch setting failed and its prior state could not be fully restored." "" "$host_enabled" rollback_failed
    host_finish failed "Launch setting could not be changed; prior setting restored." "" "$host_enabled" apply_failed
  fi
fi
if printf '%s' "$request" | jq -e 'type=="object" and (.action=="install" or .action=="launch_at_boot" or .action=="apply_config")' >/dev/null 2>&1; then
  invalid_host_id=$(printf '%s' "$request" | jq -r 'if (.id|type)=="string" and (.id|test("^[0-9a-f]{32}$")) then .id else "" end')
  invalid_host_action=$(printf '%s' "$request" | jq -r .action)
  write_host_status "$invalid_host_id" "$invalid_host_action" rejected "Invalid request." "" "" invalid_request
  clear_request
  exit 0
fi
if ! printf '%s' "$request" | jq -e --argjson now "$now" '
  type=="object" and keys==["active","confirmation","id","node","requested_at"] and
  (.id|type=="string" and test("^[0-9a-f]{32}$")) and
  (.node=="bitcoin" or .node=="monero" or .node=="tari" or .node=="litecoin" or .node=="dogecoin" or .node=="bitcoincash" or .node=="zcash") and
  (.active|type=="boolean") and (.confirmation|type=="string") and
  (if .active then .confirmation=="" else .confirmation=="deactivate" end) and
  (.requested_at|type=="number" and floor==. and . >= $now-300 and . <= $now+30)
' >/dev/null 2>&1; then
  write_status "" "" false rejected "Invalid request." invalid_request
  clear_request
  exit 0
fi
id=$(printf '%s' "$request" | jq -r .id)
node=$(printf '%s' "$request" | jq -r .node)
active=$(printf '%s' "$request" | jq -r .active)
seen_file=$state_root/node-control/seen
if [ -r "$seen_file" ] && grep -Fxq "$id" "$seen_file"; then
  write_status "$id" "$node" "$active" rejected "Request already processed." replayed
  clear_request
  exit 0
fi
remember_seen() {
  printf '%s\n' "$id" >>"$seen_file"
  seen_tmp=$(mktemp "$state_root/node-control/.seen.XXXXXX")
  tail -n 256 "$seen_file" >"$seen_tmp"
  chmod 600 "$seen_tmp"
  mv "$seen_tmp" "$seen_file"
}
mkdir -p "$config_root"
exec 8>"$state_root/.config.lock"
flock 8
if config_pending; then
  write_status "$id" "$node" "$active" rejected "Review the pending config change first." config_pending
  remember_seen
  clear_request
  exit 0
fi
current='{}'
[ -f "$config_file" ] && current=$(cat "$config_file")
if [ "$(printf '%s' "$current" | jq -r --arg node "$node" '.[$node].enabled // (if $node=="bitcoin" then true else false end)')" != true ]; then
  write_status "$id" "$node" "$active" rejected "Node is not configured." node_not_configured
  remember_seen
  clear_request
  exit 0
fi
old_active=$(printf '%s' "$current" | jq -r --arg node "$node" 'if (.[$node] // {} | has("active")) then .[$node].active else true end')
if [ "$old_active" = "$active" ]; then
  write_status "$id" "$node" "$active" rejected "Node is already in that state." unchanged
  remember_seen
  clear_request
  exit 0
fi
next=$(mktemp "$config_root/.config.node-control.XXXXXX")
printf '%s' "$current" | jq --arg node "$node" --argjson active "$active" '.[$node].active=$active' >"$next"
validate=$(mktemp -d "$state_root/node-control/.validate.XXXXXX")
cp "$next" "$validate/config.json"
if ! BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$validate" BITCOIN_STACK_VALIDATE_ONLY=1 BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/configure.sh" >/dev/null 2>&1; then
  rm -rf "$next" "$validate"
  write_status "$id" "$node" "$active" rejected "Node state is invalid." validation_failed
  remember_seen
  clear_request
  exit 0
fi
rm -rf "$validate"
backup=$(mktemp "$state_root/node-control/.config.backup.XXXXXX")
printf '%s' "$current" >"$backup"
chmod 600 "$next" "$backup"
mv "$next" "$config_file"
restore_services() {
  if [ "$old_active" = true ]; then
    if [ "$node" = monero ]; then
      "$stack_root/stack" up monero monero-wallet >/dev/null 2>&1
    elif [ "$node" = tari ]; then
      "$stack_root/stack" up tari tari-wallet >/dev/null 2>&1
    else
      "$stack_root/stack" up "$node" >/dev/null 2>&1
    fi
  elif [ "$node" = monero ]; then
    "$stack_root/stack" stop monero-wallet monero >/dev/null 2>&1
  elif [ "$node" = tari ]; then
    "$stack_root/stack" stop tari-wallet tari >/dev/null 2>&1
  else
    "$stack_root/stack" stop "$node" >/dev/null 2>&1
  fi
}
rollback() {
  attempted_services=$1
  rollback_failed=0
  mv "$backup" "$config_file" || rollback_failed=1
  if ! BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/configure.sh" >/dev/null 2>&1; then
    rollback_failed=1
  fi
  if [ "$attempted_services" = 1 ] && ! restore_services; then
    rollback_failed=1
  fi
  if [ "$rollback_failed" = 1 ]; then
    write_status "$id" "$node" "$active" failed "Node state failed and its prior state could not be fully restored." rollback_failed
  else
    write_status "$id" "$node" "$active" failed "Node state could not be applied; prior state restored." apply_failed
  fi
  remember_seen
  clear_request
  exit 0
}
if ! BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/configure.sh" >/dev/null; then
  rollback 0
fi
set -- "$node"
[ "$node" = monero ] && set -- monero-wallet monero
[ "$node" = tari ] && set -- tari-wallet tari
if [ "$active" = true ]; then
  action="up"
  [ "$node" = monero ] && set -- monero monero-wallet
  [ "$node" = tari ] && set -- tari tari-wallet
else action="stop"; fi
if ! "$stack_root/stack" $action "$@" >/dev/null 2>&1; then
  rollback 1
fi
if ! runtime=$(jq -c '
  {
    bitcoin:{enabled:(if (.bitcoin//{}|has("enabled")) then .bitcoin.enabled else true end),active:(if (.bitcoin//{}|has("active")) then .bitcoin.active else true end)},
    monero:{enabled:(.monero.enabled==true),active:(if (.monero//{}|has("active")) then .monero.active else true end)},
    tari:{enabled:(.tari.enabled==true),active:(if (.tari//{}|has("active")) then .tari.active else true end)},
    litecoin:{enabled:(.litecoin.enabled==true),active:(if (.litecoin//{}|has("active")) then .litecoin.active else true end)},
    dogecoin:{enabled:(.dogecoin.enabled==true),active:(if (.dogecoin//{}|has("active")) then .dogecoin.active else true end)},
    bitcoincash:{enabled:(.bitcoincash.enabled==true),active:(if (.bitcoincash//{}|has("active")) then .bitcoincash.active else true end)},
    zcash:{enabled:(.zcash.enabled==true),active:(if (.zcash//{}|has("active")) then .zcash.active else true end)}
  } | with_entries(select(.value.enabled) | .value=.value.active)
' "$config_file"); then
  rollback 1
fi
if ! printf '%s\n' "$runtime" | $docker_bin exec -i -u 1000 "$dashboard_id" sh -c 'umask 077; cat > /state/.node-runtime.json.tmp; mv /state/.node-runtime.json.tmp /state/node-runtime.json' >/dev/null; then
  rollback 1
fi
approve_config || rollback 1
rm -f "$backup"
write_status "$id" "$node" "$active" applied "Node state applied."
remember_seen
clear_request
