#!/bin/sh
set -eu

: "${HOME:?HOME must be set}"
case "$HOME" in /*) ;; *) echo "HOME must be an absolute path." >&2; exit 1 ;; esac

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
state_home=${XDG_STATE_HOME:-$HOME/.local/state}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
for path in "$config_home" "$state_home" "$data_home"; do
  case "$path" in /*) ;; *) echo "XDG directories must be absolute paths." >&2; exit 1 ;; esac
  if [ -e "$path" ] && [ ! -d "$path" ]; then
    echo "$path is not a directory." >&2
    exit 1
  fi
done

config_dir=$config_home/bitcoin-starter-stack
state_dir=$state_home/bitcoin-starter-stack
data_dir=$data_home/bitcoin-starter-stack
for path in "$config_dir" "$state_dir" "$data_dir"; do
  if [ -e "$path" ] && [ ! -d "$path" ]; then
    echo "$path exists and is not a directory." >&2
    exit 1
  fi
done

umask 077
mkdir -p "$config_dir" "$state_dir" "$data_dir"
export BITCOIN_STACK_ROOT="${BITCOIN_STACK_ROOT:-/usr/lib/bitcoin-starter-stack}"
export BITCOIN_STACK_CONFIG_DIR="$config_dir"
export BITCOIN_STACK_STATE_DIR="$state_dir"
export BITCOIN_STACK_DATA_DIR="$data_dir"
export BITCOIN_STACK_COMMAND=bitcoin-stack
export BITCOIN_STACK_PACKAGE_MANAGED=1
exec "$BITCOIN_STACK_ROOT/stack" "$@"
