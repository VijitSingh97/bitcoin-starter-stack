#!/bin/sh
set -eu

stack_root=${BITCOIN_STACK_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}
state_root=${BITCOIN_STACK_STATE_DIR:-$stack_root}
config_root=${BITCOIN_STACK_CONFIG_DIR:-$state_root}
env_file=$state_root/.env
config_file=$config_root/config.json
approved_config=$state_root/.approved-config.json
config_lock=$state_root/.config.lock
docker_bin=${DOCKER_BIN:-docker}
ss_bin=${SS_BIN:-ss}
ip_bin=${IP_BIN:-ip}
netstat_bin=${NETSTAT_BIN:-/usr/sbin/netstat}
ifconfig_bin=${IFCONFIG_BIN:-/sbin/ifconfig}
host_os=${PORT_CONTROL_OS:-$(uname -s)}
control_state=$state_root/port-control
credential_state=$state_root/credential-control
request_path=/state/port-control.request
processing_path=/state/port-control.processing
credential_request_path=/state/credential-control.request
credential_processing_path=/state/credential-control.processing
credential_capability_path=/state/credential-control.capability
now=${PORT_CONTROL_NOW_EPOCH:-$(date +%s)}

[ -r "$env_file" ] || exit 0
mkdir -p "$control_state"
chmod 700 "$control_state"
mkdir -p "$credential_state"
chmod 700 "$credential_state"
exec 9>"$control_state/.lock"
flock -n 9 || exit 0

env_get() {
  sed -n "s/^$1=//p" "$env_file" | tail -n 1
}

dashboard_id=$($docker_bin inspect --format '{{.Id}}' dashboard 2>/dev/null || true)
[ -n "$dashboard_id" ] || exit 0
config_files=$($docker_bin inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files" }}' "$dashboard_id" 2>/dev/null || true)
case ",$config_files," in
  *",$stack_root/docker-compose.yml,"*) ;;
  *) exit 0 ;;
esac

dashboard_exec() {
  "$docker_bin" exec -u 1000 dashboard "$@"
}

write_status() {
  status=$(jq -nc --arg id "$1" --arg state "$2" --arg message "$3" \
    --arg error_code "${4:-}" --arg port "${5:-}" '
      {id:$id,state:$state,message:$message,affected_services:["tor","dashboard"]} |
      if $error_code == "" then . else . + {error_code:$error_code} end |
      if $port == "" then . else . + {port:$port} end')
  printf '%s\n' "$status" | "$docker_bin" exec -i -u 1000 dashboard sh -c \
    'umask 077; cat >/state/.port-control.status.tmp; mv /state/.port-control.status.tmp /state/port-control.status' >/dev/null
}

clear_processing() {
  dashboard_exec rm -f "$processing_path" >/dev/null 2>&1 || true
}

approve_config() {
  BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
    BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/stack" approve-rendered-config >/dev/null 2>&1
}

canonical_config() {
  if [ -f "$1" ]; then jq -S -c . "$1" 2>/dev/null; else printf '{}\n'; fi
}

config_pending() {
  current_approved=$(canonical_config "$config_file") || return 0
  saved_approved=$(canonical_config "$approved_config") || return 0
  [ -f "$approved_config" ] && [ "$current_approved" = "$saved_approved" ] && return 1
  return 0
}

write_port_candidate() {
  jq --argjson changes "$changes" '
    reduce $changes[] as $change (.;
      if $change.port == "bitcoin_rpc" then
        .bitcoin.rpc_expose = $change.enabled |
        if $change.enabled then .bitcoin.rpc_bind_ip = $change.bind_ip | .bitcoin.rpc_port = $change.host_port else . end
      elif $change.port == "monero_rpc" then
        .monero.rpc_expose = $change.enabled |
        if $change.enabled then .monero.rpc_bind_ip = $change.bind_ip | .monero.rpc_port = $change.host_port else . end
      elif $change.port == "monero_zmq" then
        .monero.zmq_expose = $change.enabled |
        if $change.enabled then .monero.zmq_bind_ip = $change.bind_ip | .monero.zmq_port = $change.host_port else . end
      elif $change.port == "tari_grpc" then
        .tari.grpc_expose = $change.enabled | if $change.enabled then .tari.grpc_bind_ip=$change.bind_ip | .tari.grpc_port=$change.host_port else . end
      elif $change.port == "litecoin_rpc" then
        .litecoin.rpc_expose = $change.enabled | if $change.enabled then .litecoin.rpc_bind_ip=$change.bind_ip | .litecoin.rpc_port=$change.host_port else . end
      elif $change.port == "dogecoin_rpc" then
        .dogecoin.rpc_expose = $change.enabled | if $change.enabled then .dogecoin.rpc_bind_ip=$change.bind_ip | .dogecoin.rpc_port=$change.host_port else . end
      elif $change.port == "bitcoincash_rpc" then
        .bitcoincash.rpc_expose = $change.enabled | if $change.enabled then .bitcoincash.rpc_bind_ip=$change.bind_ip | .bitcoincash.rpc_port=$change.host_port else . end
      else
        .zcash.rpc_expose = $change.enabled | if $change.enabled then .zcash.rpc_bind_ip=$change.bind_ip | .zcash.rpc_port=$change.host_port else . end
      end)
  ' "$1" >"$2"
}

write_credential_status() {
  status=$(jq -nc --arg id "$1" --arg node "$2" --arg state "$3" --arg message "$4" --argjson affected_services "${5:-[]}" \
    '{id:$id,node:$node,state:$state,message:$message,affected_services:$affected_services}')
  printf '%s\n' "$status" | "$docker_bin" exec -i -u 1000 dashboard sh -c \
    'umask 077; cat >/state/.credential-control.status.tmp; mv /state/.credential-control.status.tmp /state/credential-control.status' >/dev/null
}

clear_credential_processing() {
  dashboard_exec rm -f "$credential_processing_path" >/dev/null 2>&1 || true
}

remove_credential_capability() {
  dashboard_exec rm -f "$credential_capability_path" >/dev/null 2>&1 || true
}

write_credential_capability() {
  jq -nc --argjson timestamp "$now" '{timestamp:$timestamp}' | "$docker_bin" exec -i -u 1000 dashboard sh -c \
    'umask 077; cat >/state/.credential-control.capability.tmp; mv /state/.credential-control.capability.tmp /state/credential-control.capability' >/dev/null
}

credential_resource_limits() {
  [ "$1" != zcash ] || return 0
  limits=$($docker_bin inspect --format '{{.HostConfig.NanoCpus}} {{.HostConfig.Memory}} {{.HostConfig.MemorySwap}}' "$1" 2>/dev/null) || return 1
  printf '%s' "$limits" | grep -Eq '^[0-9]+ [0-9]+ -?[0-9]+$' || return 1
  printf '%s\n' "$limits"
}

private_ipv4() {
  ip=$1
  case "$ip" in
    *[!0-9.]* | .* | *. | *..*) return 1 ;;
  esac
  IFS=. read -r a b c d extra <<EOF
$ip
EOF
  [ -z "$extra" ] || return 1
  set -- "$a" "$b" "$c" "$d"
  for octet in "$@"; do
    case "$octet" in '' | *[!0-9]* | 0[0-9]* | 00*) return 1 ;; esac
    [ "$octet" -le 255 ] || return 1
  done
  if [ "$1" = 10 ]; then
    return 0
  fi
  if [ "$1" = 172 ] && [ "$2" -ge 16 ] && [ "$2" -le 31 ]; then
    return 0
  fi
  [ "$1" = 192 ] && [ "$2" = 168 ]
}

published_ports() {
  ports_json=$("$docker_bin" inspect --format '{{json .NetworkSettings.Ports}}' "$1" 2>/dev/null) || return 1
  printf '%s' "$ports_json" | jq -e 'type == "object"' >/dev/null 2>&1 || return 1
  printf '%s' "$ports_json" | jq -r 'to_entries[] | select(.key | endswith("/tcp")) | .value[]? |
    [.HostIp, .HostPort] | @tsv'
}

binding_conflicts() {
  desired_ip=$1
  desired_port=$2
  occupied_ip=$3
  occupied_port=$4
  case "$occupied_ip" in ::ffff:*) occupied_ip=${occupied_ip#::ffff:} ;; esac
  [ "$desired_port" = "$occupied_port" ] || return 1
  case "$occupied_ip" in
    '' | 0.0.0.0 | '*' | :: | '[::]') return 0 ;;
  esac
  [ "$desired_ip" = "$occupied_ip" ]
}

own_listener() {
  listener_ip=$1
  listener_port=$2
  normalized_listener_ip=$listener_ip
  case "$normalized_listener_ip" in ::ffff:*) normalized_listener_ip=${normalized_listener_ip#::ffff:} ;; esac
  case "$normalized_listener_ip" in '' | '*' | :: | '[::]') normalized_listener_ip=0.0.0.0 ;; esac
  while IFS="$(printf '\t')" read -r own_ip own_port; do
    case "$own_ip" in ::ffff:*) own_ip=${own_ip#::ffff:} ;; esac
    case "$own_ip" in '' | '*' | :: | '[::]') own_ip=0.0.0.0 ;; esac
    if [ "$own_ip" = "$normalized_listener_ip" ] && [ "$own_port" = "$listener_port" ]; then
      return 0
    fi
  done <<EOF
$own_bindings
EOF
  return 1
}

port_available() {
  desired_ip=$1
  desired_port=$2
  while IFS="$(printf '\t')" read -r occupied_ip occupied_port; do
    [ -n "$occupied_port" ] || continue
    binding_conflicts "$desired_ip" "$desired_port" "$occupied_ip" "$occupied_port" && return 1
  done <<EOF
$other_bindings
EOF
  while IFS="$(printf '\t')" read -r occupied_ip occupied_port; do
    [ -n "$occupied_port" ] || continue
    if binding_conflicts "$desired_ip" "$desired_port" "$occupied_ip" "$occupied_port" &&
      ! own_listener "$occupied_ip" "$occupied_port"; then
      return 1
    fi
  done <<EOF
$host_bindings
EOF
}

host_tcp_listeners() {
  case "$host_os" in
    Linux)
      output=$($ss_bin -H -ltn 2>/dev/null) || return 1
      printf '%s\n' "$output" | awk '
        NF == 0 { next }
        NF < 4 { bad=1; next }
        {
          endpoint=$4
          if (endpoint ~ /^\[/) {
            sub(/^\[/, "", endpoint)
            count=split(endpoint, parts, /\]:/)
            if (count == 2 && parts[2] ~ /^[0-9]+$/) print parts[1] "\t" parts[2]
            else bad=1
          } else {
            port=endpoint
            sub(/^.*:/, "", port)
            address=endpoint
            sub(/:[^:]*$/, "", address)
            if (port ~ /^[0-9]+$/ && address != "") print address "\t" port
            else bad=1
          }
        }
        END { exit bad }
      '
      ;;
    Darwin)
      output=$("$netstat_bin" -an -p tcp 2>/dev/null) || return 1
      printf '%s\n' "$output" | awk '
        $1 !~ /^tcp/ { next }
        $1 !~ /^tcp(4|6|46)?$/ { if ($NF == "LISTEN") bad=1; next }
        $NF != "LISTEN" { next }
        {
          if (NF < 5) { bad=1; next }
          endpoint=$4
          if (!match(endpoint, /\.[0-9]+$/)) { bad=1; next }
          address=substr(endpoint, 1, RSTART - 1)
          port=substr(endpoint, RSTART + 1)
          if (address == "" || port !~ /^[0-9]+$/) bad=1
          else print address "\t" port
        }
        END { exit bad }
      '
      ;;
    *) return 1 ;;
  esac
}

host_ipv4_addresses() {
  case "$host_os" in
    Linux)
      output=$($ip_bin -o -4 addr show 2>/dev/null) || return 1
      ;;
    Darwin)
      output=$($ifconfig_bin -a 2>/dev/null) || return 1
      ;;
    *) return 1 ;;
  esac
  addresses=$(printf '%s\n' "$output" | awk '
    {
      for (i=1; i<=NF; i++) {
        if ($i == "inet" && (i + 1) <= NF) {
          address=$(i + 1)
          sub(/\/.*/, "", address)
          if (address ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) print address
        }
      }
    }
  ')
  [ -n "$addresses" ] || return 1
  printf '%s\n' "$addresses"
}

process_credential_request() {
  if ! dashboard_exec test -f "$credential_processing_path" >/dev/null 2>&1; then
    dashboard_exec test -f "$credential_request_path" >/dev/null 2>&1 || return 1
    if dashboard_exec sh -c \
      'test -e /state/port-control.request || test -e /state/port-control.processing || test -e /state/node-control.request || test -e /state/node-control.processing' \
      >/dev/null 2>&1; then
      dashboard_exec mv "$credential_request_path" "$credential_processing_path" >/dev/null 2>&1 || return 0
      conflict_request=$(dashboard_exec cat "$credential_processing_path" 2>/dev/null || true)
      conflict_id=$(printf '%s' "$conflict_request" | jq -r 'if type == "object" and (.id | type == "string") then .id else "" end' 2>/dev/null || true)
      conflict_node=$(printf '%s' "$conflict_request" | jq -r 'if type == "object" and (.node | type == "string") then .node else "" end' 2>/dev/null || true)
      write_credential_status "$conflict_id" "$conflict_node" rejected "Another node setting change is pending." '[]'
      clear_credential_processing
      return 0
    fi
    dashboard_exec mv "$credential_request_path" "$credential_processing_path" >/dev/null 2>&1 || return 0
  fi

  credential_size=$(dashboard_exec sh -c 'wc -c < /state/credential-control.processing' 2>/dev/null | tr -d ' ' || true)
  case "$credential_size" in '' | *[!0-9]*) credential_size=2049 ;; esac
  if [ "$credential_size" -gt 2048 ]; then
    write_credential_status "" "" rejected "Invalid request." '[]'
    clear_credential_processing
    return 0
  fi
  credential_request=$(dashboard_exec cat "$credential_processing_path" 2>/dev/null || true)
  if ! printf '%s' "$credential_request" | jq -e --argjson now "$now" '
    type == "object" and keys == ["id", "node", "requested_at"] and
    (.id | type == "string" and test("^[0-9a-f]{32}$")) and
    (.node == "bitcoin" or .node == "monero" or .node == "litecoin" or .node == "dogecoin" or .node == "bitcoincash" or .node == "zcash") and
    (.requested_at | type == "number" and floor == . and . >= $now - 300 and . <= $now + 30)
  ' >/dev/null 2>&1; then
    write_credential_status "" "" rejected "Invalid request." '[]'
    clear_credential_processing
    return 0
  fi

  credential_id=$(printf '%s' "$credential_request" | jq -r .id)
  credential_node=$(printf '%s' "$credential_request" | jq -r .node)
  case "$credential_node" in
    bitcoin) credential_services='["bitcoin","dashboard"]' ;;
    monero) credential_services='["monero","monero-wallet","dashboard"]' ;;
    litecoin) credential_services='["litecoin","dashboard"]' ;;
    dogecoin) credential_services='["dogecoin","dashboard"]' ;;
    bitcoincash) credential_services='["bitcoincash","dashboard"]' ;;
    zcash) credential_services='["dashboard"]' ;;
  esac
  credential_seen=$credential_state/seen
  remember_credential_seen() {
    printf '%s\n' "$credential_id" >>"$credential_seen"
    chmod 600 "$credential_seen"
    credential_seen_tmp=$(mktemp "$credential_state/.seen.tmp.XXXXXX")
    tail -n 256 "$credential_seen" >"$credential_seen_tmp"
    chmod 600 "$credential_seen_tmp"
    mv "$credential_seen_tmp" "$credential_seen"
  }

  credential_inflight=$credential_state/inflight
  credential_transaction_before=$credential_state/transaction.before
  credential_transaction_after=$credential_state/transaction.after
  credential_limits_file=$credential_state/transaction.limits
  credential_env_before=$credential_state/transaction.env.before
  credential_intent_file=$credential_state/transaction.intent
  credential_result_file=$credential_state/transaction.result
  if [ -s "$credential_result_file" ]; then
    if jq -e --arg id "$credential_id" --arg node "$credential_node" '
      type == "object" and keys == ["affected_services", "id", "message", "node", "state"] and
      .id == $id and .node == $node and
      (.state == "applied" or .state == "failed") and
      (.message | type == "string") and
      (.affected_services | type == "array" and all(.[]; type == "string"))
    ' "$credential_result_file" >/dev/null 2>&1; then
      credential_result_state=$(jq -r .state "$credential_result_file")
      credential_result_message=$(jq -r .message "$credential_result_file")
      credential_result_services=$(jq -c .affected_services "$credential_result_file")
      write_credential_status "$credential_id" "$credential_node" "$credential_result_state" "$credential_result_message" "$credential_result_services"
      rm -f "$credential_transaction_before" "$credential_transaction_after" "$credential_limits_file" "$credential_env_before" "$credential_intent_file" "$credential_inflight"
      remember_credential_seen
      clear_credential_processing
      rm -f "$credential_result_file"
      return 0
    fi
    if [ ! -s "$credential_inflight" ]; then
      rm -f "$credential_result_file"
    else
      write_credential_status "$credential_id" "$credential_node" failed "An interrupted credential reset requires recovery." "$credential_services"
      remove_credential_capability
      return 0
    fi
  fi
  if [ -r "$credential_seen" ] && grep -Fxq "$credential_id" "$credential_seen"; then
    write_credential_status "$credential_id" "$credential_node" rejected "Request already processed." "$credential_services"
    clear_credential_processing
    return 0
  fi
  mkdir -p "$config_root"
  exec 8>"$config_lock"
  flock 8
  prior_inflight=$(cat "$credential_inflight" 2>/dev/null || true)
  if config_pending && [ "$prior_inflight" != "$credential_id" ]; then
    remember_credential_seen
    clear_credential_processing
    write_credential_status "$credential_id" "$credential_node" rejected "Review the pending config change first." "$credential_services"
    return 0
  fi
  credential_committed=0
  credential_committed_snapshot=$credential_transaction_after
  credential_rollback_snapshot=$credential_transaction_before
  credential_recovering_rollback=0
  if [ -n "$prior_inflight" ] && [ "$prior_inflight" != "$credential_id" ]; then
    write_credential_status "$credential_id" "$credential_node" failed "An interrupted credential reset requires recovery." "$credential_services"
    remove_credential_capability
    return 0
  fi
  if [ "$prior_inflight" = "$credential_id" ] && [ -f "$credential_transaction_before" ] &&
    [ -f "$credential_transaction_after" ] && [ -f "$credential_limits_file" ] && [ -f "$credential_env_before" ] && [ -f "$credential_intent_file" ]; then
    credential_intent=$(cat "$credential_intent_file")
    if [ "$credential_intent" = rollback ]; then
      credential_recovering_rollback=1
      credential_recovery_source=$credential_transaction_before
      credential_recovery_other=$credential_transaction_after
    elif [ "$credential_intent" = apply ]; then
      credential_recovery_source=$credential_transaction_after
      credential_recovery_other=$credential_transaction_before
    else
      write_credential_status "$credential_id" "$credential_node" failed "Interrupted credential reset could not be recovered safely." "$credential_services"
      remove_credential_capability
      return 0
    fi
    if [ "$credential_recovering_rollback" = 1 ]; then
      cp "$credential_env_before" "$env_file"
      chmod 600 "$env_file"
    fi
    if cmp -s "$config_file" "$credential_recovery_source"; then
      credential_committed=1
    elif cmp -s "$config_file" "$credential_recovery_other"; then
      credential_recovery_tmp=$(mktemp "$config_root/.config.credential-recovery.XXXXXX")
      cp "$credential_recovery_source" "$credential_recovery_tmp"
      chmod 600 "$credential_recovery_tmp"
      mv "$credential_recovery_tmp" "$config_file"
      credential_committed=1
    else
      write_credential_status "$credential_id" "$credential_node" failed "Interrupted credential reset could not be recovered safely." "$credential_services"
      remove_credential_capability
      return 0
    fi
  fi
  if [ "$credential_committed" != 1 ] && ! new_password=$(openssl rand -hex 24); then
    write_credential_status "$credential_id" "$credential_node" failed "RPC password could not be generated." "$credential_services"
    remove_credential_capability
    clear_credential_processing
    return 0
  fi
  credential_attempt=0
  while [ "$credential_committed" != 1 ] && [ "$credential_attempt" -lt 3 ]; do
    credential_attempt=$((credential_attempt + 1))
    if config_pending; then
      rm -f "$credential_inflight" "$credential_transaction_before" "$credential_transaction_after" "$credential_limits_file" "$credential_env_before" "$credential_intent_file"
      remember_credential_seen
      clear_credential_processing
      write_credential_status "$credential_id" "$credential_node" rejected "Review the pending config change first." "$credential_services"
      return 0
    fi
    credential_config_snapshot=$(mktemp "$credential_state/.config.snapshot.XXXXXX")
    credential_config_tmp=$(mktemp "$config_root/.config.credential-control.XXXXXX")
    credential_validate_dir=$(mktemp -d "$credential_state/.validate.XXXXXX")
    chmod 600 "$credential_config_snapshot" "$credential_config_tmp"
    if [ -f "$config_file" ]; then
      credential_had_config=1
      cat "$config_file" >"$credential_config_snapshot"
    else
      credential_had_config=0
      printf '{}\n' >"$credential_config_snapshot"
    fi
    if ! jq -e --arg node "$credential_node" '
      type == "object" and
      (.[$node] | type == "object") and
      (if $node == "bitcoin" and (.bitcoin | has("enabled") | not) then true else .[$node].enabled == true end) and
      (if .[$node] | has("active") then .[$node].active == true else true end) and
      .[$node].rpc_expose == true
    ' "$credential_config_snapshot" >/dev/null 2>&1; then
      rm -rf "$credential_config_snapshot" "$credential_config_tmp" "$credential_validate_dir"
      remember_credential_seen
      clear_credential_processing
      write_credential_status "$credential_id" "$credential_node" rejected "LAN RPC is not enabled for this node." "$credential_services"
      return 0
    fi
    printf '%s' "$new_password" | jq --arg node "$credential_node" --rawfile password /dev/stdin \
      '.[$node].node_password=$password' "$credential_config_snapshot" >"$credential_config_tmp"
    cp "$credential_config_tmp" "$credential_validate_dir/config.json"
    if ! BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$credential_validate_dir" \
      BITCOIN_STACK_VALIDATE_ONLY=1 BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/configure.sh" >/dev/null 2>&1; then
      rm -rf "$credential_config_snapshot" "$credential_config_tmp" "$credential_validate_dir"
      remember_credential_seen
      clear_credential_processing
      write_credential_status "$credential_id" "$credential_node" rejected "RPC password could not be saved." "$credential_services"
      return 0
    fi
    rm -rf "$credential_validate_dir"
    if { [ "$credential_had_config" = 1 ] && [ -f "$config_file" ] && cmp -s "$credential_config_snapshot" "$config_file"; } ||
      { [ "$credential_had_config" = 0 ] && [ ! -e "$config_file" ]; }; then
      [ "$credential_had_config" = 1 ] || {
        rm -f "$credential_config_snapshot" "$credential_config_tmp"
        break
      }
      cp "$credential_config_snapshot" "$credential_transaction_before"
      cp "$credential_config_tmp" "$credential_transaction_after"
      cp "$env_file" "$credential_env_before"
      if ! credential_limits=$(credential_resource_limits "$credential_node"); then
        rm -f "$credential_config_snapshot" "$credential_config_tmp" "$credential_transaction_before" "$credential_transaction_after" "$credential_env_before"
        break
      fi
      printf '%s\n' "$credential_limits" >"$credential_limits_file"
      printf 'apply\n' >"$credential_intent_file"
      printf '%s\n' "$credential_id" >"$credential_inflight"
      chmod 600 "$credential_transaction_before" "$credential_transaction_after" "$credential_limits_file" "$credential_env_before" "$credential_intent_file" "$credential_inflight"
      mv "$credential_config_tmp" "$config_file"
      rm -f "$credential_config_snapshot"
      credential_committed=1
      break
    fi
    rm -f "$credential_config_snapshot" "$credential_config_tmp"
  done
  if [ "$credential_committed" != 1 ]; then
    rm -f "$credential_inflight" "$credential_transaction_before" "$credential_transaction_after" "$credential_limits_file" "$credential_env_before" "$credential_intent_file"
    remember_credential_seen
    clear_credential_processing
    write_credential_status "$credential_id" "$credential_node" failed "RPC password could not be saved." "$credential_services"
    remove_credential_capability
    return 0
  fi

  credential_limits=$(cat "$credential_limits_file")
  if BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
    BITCOIN_STACK_PACKAGE_MANAGED="${BITCOIN_STACK_PACKAGE_MANAGED:-0}" BITCOIN_STACK_CONFIG_LOCK_HELD=1 \
    BITCOIN_STACK_CREDENTIAL_LIMITS="$credential_limits" \
    "$stack_root/stack" apply-credential-settings "$credential_node" >/dev/null 2>&1; then
    if [ "$credential_recovering_rollback" = 1 ]; then
      credential_final_state=failed
      credential_final_message="RPC password could not be applied; prior credentials were restored."
    else
      credential_final_state=applied
      credential_final_message="RPC password reset."
    fi
  else
    remove_credential_capability
    if [ "$credential_recovering_rollback" = 1 ]; then
      write_credential_status "$credential_id" "$credential_node" failed "Prior RPC credentials could not be restored; recovery will retry." "$credential_services"
      return 0
    fi
    credential_intent_tmp=$(mktemp "$credential_state/.transaction.intent.XXXXXX")
    printf 'rollback\n' >"$credential_intent_tmp"
    chmod 600 "$credential_intent_tmp"
    mv "$credential_intent_tmp" "$credential_intent_file"
    if ! cmp -s "$credential_committed_snapshot" "$config_file"; then
      write_credential_status "$credential_id" "$credential_node" failed "RPC password could not be applied and configuration changed during recovery." "$credential_services"
      return 0
    fi
    credential_rollback_tmp=$(mktemp "$config_root/.config.credential-control-rollback.XXXXXX")
    cat "$credential_rollback_snapshot" >"$credential_rollback_tmp"
    chmod 600 "$credential_rollback_tmp"
    mv "$credential_rollback_tmp" "$config_file"
    cp "$credential_env_before" "$env_file"
    chmod 600 "$env_file"
    if BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
      BITCOIN_STACK_PACKAGE_MANAGED="${BITCOIN_STACK_PACKAGE_MANAGED:-0}" BITCOIN_STACK_CONFIG_LOCK_HELD=1 \
      BITCOIN_STACK_CREDENTIAL_LIMITS="$credential_limits" \
      "$stack_root/stack" apply-credential-settings "$credential_node" >/dev/null 2>&1; then
      credential_final_state=failed
      credential_final_message="RPC password could not be applied; prior credentials were restored."
    else
      write_credential_status "$credential_id" "$credential_node" failed "Prior RPC credentials could not be restored; recovery will retry." "$credential_services"
      return 0
    fi
  fi
  if [ "$credential_final_state" = applied ] && ! approve_config; then
    credential_final_state=failed
    credential_final_message="RPC password was applied, but its configuration approval could not be saved."
  fi
  credential_result_tmp=$(mktemp "$credential_state/.transaction.result.XXXXXX")
  jq -nc --arg id "$credential_id" --arg node "$credential_node" --arg state "$credential_final_state" \
    --arg message "$credential_final_message" --argjson affected_services "$credential_services" \
    '{id:$id,node:$node,state:$state,message:$message,affected_services:$affected_services}' >"$credential_result_tmp"
  chmod 600 "$credential_result_tmp"
  mv "$credential_result_tmp" "$credential_result_file"
  write_credential_status "$credential_id" "$credential_node" "$credential_final_state" "$credential_final_message" "$credential_services"
  rm -f "$credential_committed_snapshot" "$credential_rollback_snapshot" "$credential_limits_file" "$credential_env_before" "$credential_intent_file" "$credential_inflight"
  remember_credential_seen
  clear_credential_processing
  rm -f "$credential_result_file"
  return 0
}

dashboard_auth_configured() {
  [ -n "$(env_get DASHBOARD_PASSWORD)" ] && return 0
  dashboard_auth=$(dashboard_exec cat /state/dashboard_auth.json 2>/dev/null || true)
  printf '%s' "$dashboard_auth" | jq -e '
    type == "object" and keys == ["hash", "iterations", "salt", "version"] and
    .version == 1 and .iterations == 210000 and
    (.salt | type == "string" and test("^[0-9a-f]{32}$")) and
    (.hash | type == "string" and test("^[0-9a-f]{64}$"))
  ' >/dev/null 2>&1
}

dashboard_exec sh -c \
  'umask 077; printf "ready\n" > /state/.port-control.capability.tmp; mv /state/.port-control.capability.tmp /state/port-control.capability' >/dev/null
if ! dashboard_auth_configured; then
  remove_credential_capability
else
  write_credential_capability
  if process_credential_request; then
    exit 0
  fi
fi

if ! dashboard_exec test -f "$processing_path" >/dev/null 2>&1; then
  dashboard_exec test -f "$request_path" >/dev/null 2>&1 || exit 0
  dashboard_exec mv "$request_path" "$processing_path" >/dev/null 2>&1 || exit 0
fi

size=$(dashboard_exec sh -c 'wc -c < /state/port-control.processing' 2>/dev/null | tr -d ' ' || true)
case "$size" in '' | *[!0-9]*) size=4097 ;; esac
if [ "$size" -gt 4096 ]; then
  write_status "" rejected "Invalid request."
  clear_processing
  exit 0
fi
request=$(dashboard_exec cat "$processing_path" 2>/dev/null || true)
if ! printf '%s' "$request" | jq -e --argjson now "$now" '
  type == "object" and
  keys == ["changes", "id", "requested_at"] and
  (.id | type == "string" and test("^[0-9a-f]{32}$")) and
  (.requested_at | type == "number" and floor == . and . >= $now - 300 and . <= $now + 30) and
  (.changes | type == "array" and length >= 1 and length <= 8) and
  ((.changes | map(.port) | unique | length) == (.changes | length)) and
  all(.changes[];
    type == "object" and
    (.port == "bitcoin_rpc" or .port == "monero_rpc" or .port == "monero_zmq" or .port == "tari_grpc" or
     .port == "litecoin_rpc" or .port == "dogecoin_rpc" or .port == "bitcoincash_rpc" or .port == "zcash_rpc") and
    (.enabled | type == "boolean") and
    (if .enabled then
      keys == ["bind_ip", "enabled", "host_port", "port"] and
      (.bind_ip | type == "string") and
      (.host_port | type == "number" and floor == . and . >= 1 and . <= 65535)
    else keys == ["enabled", "port"] end))
' >/dev/null 2>&1; then
  write_status "" rejected "Invalid request."
  clear_processing
  exit 0
fi

while IFS="$(printf '\t')" read -r bind_ip host_port; do
  if [ -n "$bind_ip" ] && { ! private_ipv4 "$bind_ip" || [ "$host_port" -lt 1 ] || [ "$host_port" -gt 65535 ]; }; then
      write_status "" rejected "Invalid request."
      clear_processing
      exit 0
  fi
done <<EOF
$(printf '%s' "$request" | jq -r '.changes[] | select(.enabled) | [.bind_ip, (.host_port | tostring)] | @tsv')
EOF

request_id=$(printf '%s' "$request" | jq -r .id)
seen_file=$control_state/seen
if [ -r "$seen_file" ] && grep -Fxq "$request_id" "$seen_file"; then
  write_status "$request_id" rejected "Request already processed."
  clear_processing
  exit 0
fi
remember_seen() {
  printf '%s\n' "$request_id" >>"$seen_file"
  chmod 600 "$seen_file"
  seen_tmp=$(mktemp "$control_state/.seen.tmp.XXXXXX")
  tail -n 256 "$seen_file" >"$seen_tmp"
  chmod 600 "$seen_tmp"
  mv "$seen_tmp" "$seen_file"
}

changes=$(printf '%s' "$request" | jq -c .changes)
inflight_file=$control_state/inflight
inflight=$(cat "$inflight_file" 2>/dev/null || true)
mkdir -p "$config_root"
exec 8>"$config_lock"
flock 8
if config_pending; then
  recovery_expected=
  if [ "$inflight" = "$request_id" ] && [ -f "$approved_config" ]; then
    recovery_expected=$(mktemp "$control_state/.config.expected.XXXXXX")
    write_port_candidate "$approved_config" "$recovery_expected" || true
  fi
  if [ -z "$recovery_expected" ] || [ "$(canonical_config "$config_file")" != "$(canonical_config "$recovery_expected")" ]; then
    rm -f "$recovery_expected"
    remember_seen
    clear_processing
    write_status "$request_id" rejected "Review the pending config change first." config_pending
    exit 0
  fi
  rm -f "$recovery_expected"
fi

recovering=0
if [ "$inflight" = "$request_id" ]; then
  recovering=1
else
  printf '%s\n' "$request_id" >"$inflight_file"
  chmod 600 "$inflight_file"
fi
committed=0
committed_snapshot=
rollback_snapshot=
rollback_had_config=0
attempt=0
while [ "$attempt" -lt 3 ]; do
  attempt=$((attempt + 1))
  if [ "$recovering" != 1 ] && config_pending; then
    rm -f "$inflight_file"
    remember_seen
    clear_processing
    write_status "$request_id" rejected "Review the pending config change first." config_pending
    exit 0
  fi
  config_snapshot=$(mktemp "$control_state/.config.snapshot.XXXXXX")
  config_tmp=$(mktemp "$config_root/.config.port-control.XXXXXX")
  validate_dir=$(mktemp -d "$control_state/.validate.XXXXXX")
  chmod 600 "$config_snapshot" "$config_tmp"
  if [ -f "$config_file" ]; then
    had_config=1
    cat "$config_file" >"$config_snapshot"
  else
    had_config=0
    printf '{}\n' >"$config_snapshot"
  fi
  if ! jq -e --argjson changes "$changes" --argjson recovering "$recovering" --rawfile existing_env "$env_file" '
    def strong_password: type == "string" and length >= 24 and test("^[A-Za-z0-9]+$");
    def env_value($key):
      ($existing_env | split("\n") | map(select(startswith($key + "="))) | last // "") as $line |
      if $line == "" then "" else ($line | split("=")[1:] | join("=")) end;
    def effective_password($configured; $key):
      if ($configured | type == "string" and length > 0) then $configured else env_value($key) end;
    . as $config |
    type == "object" and
    all($changes[];
      (if (.port | startswith("bitcoin_rpc")) then
        (($config.bitcoin.enabled // true) == true and
          ((.enabled | not) or (effective_password($config.bitcoin.node_password; "BITCOIN_RPC_PASSWORD") | strong_password)))
      elif .port == "tari_grpc" then ($config.tari.enabled == true)
      elif .port == "litecoin_rpc" then ($config.litecoin.enabled == true and ((.enabled | not) or (effective_password($config.litecoin.node_password; "LITECOIN_RPC_PASSWORD") | strong_password)))
      elif .port == "dogecoin_rpc" then ($config.dogecoin.enabled == true and ((.enabled | not) or (effective_password($config.dogecoin.node_password; "DOGECOIN_RPC_PASSWORD") | strong_password)))
      elif .port == "bitcoincash_rpc" then ($config.bitcoincash.enabled == true and ((.enabled | not) or (effective_password($config.bitcoincash.node_password; "BITCOINCASH_RPC_PASSWORD") | strong_password)))
      elif .port == "zcash_rpc" then ($config.zcash.enabled == true and ((.enabled | not) or (effective_password($config.zcash.node_password; "ZCASH_RPC_PASSWORD") | strong_password)))
      else
        ($config.monero.enabled == true and
          ((.enabled | not) or (effective_password($config.monero.node_password; "MONERO_RPC_PASSWORD") | strong_password)))
      end) and
      ($recovering or
        (if .enabled then
           if .port == "bitcoin_rpc" then
             ($config.bitcoin.rpc_expose != true or $config.bitcoin.rpc_bind_ip != .bind_ip or ($config.bitcoin.rpc_port // 8332) != .host_port)
           elif .port == "monero_rpc" then
             ($config.monero.rpc_expose != true or $config.monero.rpc_bind_ip != .bind_ip or ($config.monero.rpc_port // 18081) != .host_port)
           elif .port == "tari_grpc" then ($config.tari.grpc_expose != true or $config.tari.grpc_bind_ip != .bind_ip or ($config.tari.grpc_port // 18142) != .host_port)
           elif .port == "litecoin_rpc" then ($config.litecoin.rpc_expose != true or $config.litecoin.rpc_bind_ip != .bind_ip or ($config.litecoin.rpc_port // 9332) != .host_port)
           elif .port == "dogecoin_rpc" then ($config.dogecoin.rpc_expose != true or $config.dogecoin.rpc_bind_ip != .bind_ip or ($config.dogecoin.rpc_port // 22555) != .host_port)
           elif .port == "bitcoincash_rpc" then ($config.bitcoincash.rpc_expose != true or $config.bitcoincash.rpc_bind_ip != .bind_ip or ($config.bitcoincash.rpc_port // 8332) != .host_port)
           elif .port == "zcash_rpc" then ($config.zcash.rpc_expose != true or $config.zcash.rpc_bind_ip != .bind_ip or ($config.zcash.rpc_port // 8232) != .host_port)
           else
             ($config.monero.zmq_expose != true or $config.monero.zmq_bind_ip != .bind_ip or ($config.monero.zmq_port // 18083) != .host_port)
           end
         elif .port == "bitcoin_rpc" then $config.bitcoin.rpc_expose == true
         elif .port == "monero_rpc" then $config.monero.rpc_expose == true
         elif .port == "tari_grpc" then $config.tari.grpc_expose == true
         elif .port == "litecoin_rpc" then $config.litecoin.rpc_expose == true
         elif .port == "dogecoin_rpc" then $config.dogecoin.rpc_expose == true
         elif .port == "bitcoincash_rpc" then $config.bitcoincash.rpc_expose == true
         elif .port == "zcash_rpc" then $config.zcash.rpc_expose == true
         else $config.monero.zmq_expose == true end)))
  ' "$config_snapshot" >/dev/null 2>&1; then
    rm -rf "$config_snapshot" "$config_tmp" "$validate_dir" "$inflight_file"
    remember_seen
    clear_processing
    write_status "$request_id" rejected "Invalid or unchanged port settings."
    exit 0
  fi
  write_port_candidate "$config_snapshot" "$config_tmp"
  cp "$config_tmp" "$validate_dir/config.json"
  if ! BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$validate_dir" \
    BITCOIN_STACK_VALIDATE_ONLY=1 BITCOIN_STACK_CONFIG_LOCK_HELD=1 "$stack_root/configure.sh" >/dev/null 2>&1; then
    rm -rf "$config_snapshot" "$config_tmp" "$validate_dir" "$inflight_file"
    remember_seen
    clear_processing
    write_status "$request_id" rejected "Invalid or conflicting port settings."
    exit 0
  fi
  rm -rf "$validate_dir"
  if printf '%s' "$changes" | jq -e 'any(.[]; .enabled)' >/dev/null; then
    tor_id=$($docker_bin inspect --format '{{.Id}}' tor 2>/dev/null || true)
    own_bindings=
    other_bindings=
    host_bindings=
    inspection_ok=1
    if [ -z "$tor_id" ] || ! own_bindings=$(published_ports "$tor_id"); then
      inspection_ok=0
    fi
    tor_config_files=$($docker_bin inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files" }}' \
      "$tor_id" 2>/dev/null || true)
    case ",$tor_config_files," in
      *",$stack_root/docker-compose.yml,"*) ;;
      *) inspection_ok=0 ;;
    esac
    if ! container_ids=$($docker_bin ps -q --no-trunc 2>/dev/null); then
      inspection_ok=0
      container_ids=
    fi
    for container_id in $container_ids; do
      [ "$container_id" = "$tor_id" ] && continue
      if ! bindings=$(published_ports "$container_id"); then
        inspection_ok=0
        break
      fi
      if [ -n "$bindings" ]; then
        other_bindings=$(printf '%s\n%s' "$other_bindings" "$bindings")
      fi
    done
    if ! host_bindings=$(host_tcp_listeners); then
      inspection_ok=0
      host_bindings=
    fi
    if ! host_ipv4s=$(host_ipv4_addresses); then
      inspection_ok=0
      host_ipv4s=
    fi
    if [ "$inspection_ok" != 1 ]; then
      rm -rf "$config_snapshot" "$config_tmp" "$inflight_file"
      remember_seen
      clear_processing
      write_status "$request_id" failed "Port availability could not be checked." port_check_failed
      exit 0
    fi
    unavailable_address_port=
    while IFS="$(printf '\t')" read -r port bind_ip; do
      [ -n "$port" ] || continue
      if ! printf '%s\n' "$host_ipv4s" | grep -Fxq "$bind_ip"; then
        unavailable_address_port=$port
        break
      fi
    done <<EOF
$(printf '%s' "$changes" | jq -r '.[] | select(.enabled) | [.port, .bind_ip] | @tsv')
EOF
    if [ -n "$unavailable_address_port" ]; then
      rm -rf "$config_snapshot" "$config_tmp" "$inflight_file"
      remember_seen
      clear_processing
      write_status "$request_id" rejected "Selected LAN address is not assigned to this host." bind_address_unavailable "$unavailable_address_port"
      exit 0
    fi
    conflict_port=
    while IFS="$(printf '\t')" read -r port bind_ip host_port; do
      [ -n "$port" ] || continue
      if ! port_available "$bind_ip" "$host_port"; then
        conflict_port=$port
        break
      fi
    done <<EOF
$(printf '%s' "$changes" | jq -r '.[] | select(.enabled) | [.port, .bind_ip, (.host_port | tostring)] | @tsv')
EOF
    if [ -n "$conflict_port" ]; then
      rm -rf "$config_snapshot" "$config_tmp" "$inflight_file"
      remember_seen
      clear_processing
      write_status "$request_id" rejected "Selected port is already in use." port_in_use "$conflict_port"
      exit 0
    fi
  fi
  if { [ "$had_config" = 1 ] && [ -f "$config_file" ] && cmp -s "$config_snapshot" "$config_file"; } ||
    { [ "$had_config" = 0 ] && [ ! -e "$config_file" ]; }; then
    rollback_snapshot=$config_snapshot
    rollback_had_config=$had_config
    committed_snapshot=$(mktemp "$control_state/.config.committed.XXXXXX")
    cp "$config_tmp" "$committed_snapshot"
    chmod 600 "$committed_snapshot"
    mv "$config_tmp" "$config_file"
    committed=1
    break
  fi
  rm -f "$config_snapshot" "$config_tmp"
done
if [ "$committed" != 1 ]; then
  rm -f "$inflight_file"
  remember_seen
  clear_processing
  write_status "$request_id" failed "Port settings could not be saved."
  exit 0
fi

if BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
  BITCOIN_STACK_PACKAGE_MANAGED="${BITCOIN_STACK_PACKAGE_MANAGED:-0}" BITCOIN_STACK_CONFIG_LOCK_HELD=1 \
  "$stack_root/stack" apply-port-settings >/dev/null 2>&1; then
  final_state=applied
  final_message="LAN port settings applied."
  if ! approve_config; then
    final_state=failed
    final_message="LAN port settings were applied, but their configuration approval could not be saved."
  fi
else
  final_state=failed
  final_message="Port settings are saved but could not be applied."
  if [ -n "$committed_snapshot" ] && cmp -s "$committed_snapshot" "$config_file"; then
    rollback_tmp=$(mktemp "$config_root/.config.port-control-rollback.XXXXXX")
    if [ "$rollback_had_config" = 1 ]; then
      cat "$rollback_snapshot" >"$rollback_tmp"
      chmod 600 "$rollback_tmp"
      mv "$rollback_tmp" "$config_file"
    else
      rm -f "$rollback_tmp" "$config_file"
    fi
    if BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
      BITCOIN_STACK_PACKAGE_MANAGED="${BITCOIN_STACK_PACKAGE_MANAGED:-0}" BITCOIN_STACK_CONFIG_LOCK_HELD=1 \
      "$stack_root/stack" apply-port-settings >/dev/null 2>&1; then
      final_message="Port settings could not be applied; prior settings were restored."
    else
      cp "$committed_snapshot" "$config_file"
      chmod 600 "$config_file"
      BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_root" BITCOIN_STACK_CONFIG_DIR="$config_root" \
        BITCOIN_STACK_PACKAGE_MANAGED="${BITCOIN_STACK_PACKAGE_MANAGED:-0}" BITCOIN_STACK_CONFIG_LOCK_HELD=1 \
        "$stack_root/configure.sh" >/dev/null 2>&1 || true
    fi
  fi
fi
rm -f "$committed_snapshot" "$rollback_snapshot"
remember_seen
rm -f "$inflight_file"
clear_processing
write_status "$request_id" "$final_state" "$final_message"
